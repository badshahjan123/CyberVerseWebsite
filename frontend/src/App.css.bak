@tailwind base;
@tailwind components;
@tailwind utilities;

/* Performance optimizations */
.glass {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.cyber-glow {
  box-shadow: 0 0 20px rgba(0, 255, 255, 0.3);
  border: 1px solid rgba(0, 255, 255, 0.5);
}

.cyber-glow:hover {
  box-shadow: 0 0 30px rgba(0, 255, 255, 0.5);
  transform: translateY(-2px);
  transition: all 0.2s ease;
}

.hover-lift {
  transition: transform 0.2s ease;
}

.hover-lift:hover {
  transform: translateY(-4px);
}

.neon-text {
  color: #00ffff;
  text-shadow: 0 0 10px rgba(0, 255, 255, 0.8);
}

.futuristic-card {
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid rgba(100, 116, 139, 0.3);
  transition: border-color 0.2s ease;
}

.futuristic-card:hover {
  border-color: rgba(0, 255, 255, 0.5);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 72px; /* offset for sticky navbar */
}


/* Enhanced Professional Color Palette - Cybersecurity Theme */
@layer base {
  :root {
    /* Dark backgrounds - deeper, richer */
    --bg: 8 12 16;
    --bg-secondary: 11 15 19;
    --surface: 15 23 32;
    --panel: 17 24 39;

    /* Text colors */
    --text: 240 246 252;
    --text-secondary: 203 213 225;
    --muted: 148 163 184;

    /* Primary - Cyber Green (like HackTheBox) */
    --primary: 155 255 0;
    --primary-hover: 178 255 51;
    --primary-glow: 155 255 0;

    /* Accent - Cyber Blue */
    --accent: 0 184 217;
    --accent-2: 124 58 237;

    /* Status colors */
    --success: 34 197 94;
    --warning: 251 191 36;
    --danger: 239 68 68;
    --info: 59 130 246;

    /* Difficulty colors */
    --difficulty-easy: 34 197 94;
    --difficulty-medium: 251 191 36;
    --difficulty-hard: 249 115 22;
    --difficulty-insane: 220 38 38;

    /* Glass effects */
    --glass: rgba(15, 23, 42, 0.4);
    --glass-border: rgba(148, 163, 184, 0.1);
    --card-border: rgba(148, 163, 184, 0.08);

    /* Glow effects */
    --glow-primary: rgba(155, 255, 0, 0.15);
    --glow-accent: rgba(0, 184, 217, 0.15);
    --glow-danger: rgba(239, 68, 68, 0.15);
  }
}

body {
  background: linear-gradient(180deg, rgb(11,15,26) 0%, rgb(4,6,12) 100%);
  color: rgb(var(--text));
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  min-height: 100vh;
}

/* Professional component styles */
@layer components {

  /* Enhanced Navbar */
  .navbar {
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 0.6));
    border-bottom: 1px solid var(--glass-border);
    backdrop-filter: blur(12px);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
  }

  /* Modern Buttons */
  .btn-primary {
    background: linear-gradient(135deg, rgb(var(--primary)), rgb(var(--primary-hover)));
    color: rgb(var(--bg));
    font-weight: 600;
    box-shadow: 0 0 20px var(--glow-primary), 0 4px 6px -1px rgba(0, 0, 0, 0.3);
    border-radius: 8px;
    padding: 0.625rem 1.25rem;
    border: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 30px var(--glow-primary), 0 8px 12px -2px rgba(0, 0, 0, 0.4);
  }

  .btn-ghost {
    background: transparent;
    border: 1px solid rgba(var(--primary), 0.3);
    color: rgb(var(--primary));
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .btn-ghost:hover {
    background: rgba(var(--primary), 0.1);
    border-color: rgb(var(--primary));
    box-shadow: 0 0 15px var(--glow-primary);
  }

  /* Professional Cards with Glassmorphism */
  .card {
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.5), rgba(15, 23, 42, 0.5));
    backdrop-filter: blur(16px);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .card:hover {
    border-color: rgba(var(--primary), 0.2);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  /* Glass Effect Enhancement */
  .glass-effect {
    background: var(--glass);
    backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
  }

  /* Glow Effects */
  .glow-effect {
    box-shadow: 0 0 20px var(--glow-primary);
  }

  .glow-accent {
    box-shadow: 0 0 20px var(--glow-accent);
  }

  /* Gradient Text */
  .gradient-text {
    background: linear-gradient(90deg, rgb(var(--primary)), rgb(var(--accent)));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-weight: 700;
  }

  /* Tag/Badge Styles */
  .tag-accent {
    background: linear-gradient(135deg, rgba(var(--accent), 0.15), rgba(var(--accent-2), 0.1));
    color: rgb(var(--accent));
    padding: 0.375rem 0.75rem;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.875rem;
    border: 1px solid rgba(var(--accent), 0.2);
  }

  /* Search and Filter Inputs */
  .labs-search-input {
    background-color: rgba(30, 41, 59, 0.6);
    color: rgb(var(--text));
    border: 1px solid var(--glass-border);
    backdrop-filter: blur(8px);
    transition: all 0.3s ease;
  }

  .labs-search-input:focus {
    border-color: rgb(var(--primary));
    box-shadow: 0 0 0 3px var(--glow-primary);
    outline: none;
  }

  .labs-search-input::placeholder {
    color: rgb(var(--muted));
  }

  .labs-dropdown {
    background-color: rgba(30, 41, 59, 0.8);
    color: rgb(var(--text));
    border: 1px solid var(--glass-border);
    backdrop-filter: blur(8px);
  }

  .labs-dropdown option {
    background-color: rgb(var(--surface));
    color: rgb(var(--text));
  }

  /* Enhanced Form Input Styles for Login/Signup */
  input[type="email"],
  input[type="password"],
  input[type="text"] {
    background: rgba(255, 255, 255, 0.1) !important;
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
    color: rgb(var(--text)) !important;
    backdrop-filter: blur(10px);
  }

  input[type="email"]:focus,
  input[type="password"]:focus,
  input[type="text"]:focus {
    background: rgba(255, 255, 255, 0.15) !important;
    border-color: rgb(var(--primary)) !important;
    box-shadow: 0 0 0 3px var(--glow-primary) !important;
  }

  input[type="email"]::placeholder,
  input[type="password"]::placeholder,
  input[type="text"]::placeholder {
    color: rgba(148, 163, 184, 0.8) !important;
  }
}

/* Ultra-smooth scrolling optimizations */
* {
  -webkit-transform: translate3d(0, 0, 0);
  transform: translate3d(0, 0, 0);
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
  -webkit-perspective: 1000px;
  perspective: 1000px;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Force hardware acceleration */
.page-container {
  transform: translate3d(0, 0, 0);
  -webkit-transform: translate3d(0, 0, 0);
  will-change: scroll-position;
  contain: layout style paint;
}

/* Optimize all interactive elements */
.card,
.button,
.grid-item,
.list-item {
  transform: translate3d(0, 0, 0);
  -webkit-transform: translate3d(0, 0, 0);
  will-change: transform;
  contain: layout style paint;
}

/* Optimize specific elements */
.card,
.button,
.nav-item,
.grid-item {
  will-change: transform;
  contain: layout style paint;
}

/* Smooth transforms */
.hover\:scale-105:hover {
  transform: scale(1.05) translateZ(0);
}

.hover\:translate-x-1:hover {
  transform: translateX(0.25rem) translateZ(0);
}

.hover\:translate-y-1:hover {
  transform: translateY(0.25rem) translateZ(0);
}

/* Ultra-optimized scrolling */
html {
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  -webkit-text-size-adjust: 100%;
}

body {
  overflow-x: hidden;
  will-change: scroll-position;
  transform: translate3d(0, 0, 0);
  -webkit-transform: translate3d(0, 0, 0);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeSpeed;
}

/* Disable problematic animations during scroll */
.scrolling * {
  pointer-events: none !important;
  animation-play-state: paused !important;
  transition: none !important;
}

/* Re-enable after scroll */
.scroll-ended * {
  pointer-events: auto !important;
  animation-play-state: running !important;
  transition: all 0.15s ease-out !important;
}

/* Performance optimized transitions */
.will-change-transform {
  will-change: transform;
  transform: translateZ(0);
}

.will-change-opacity {
  will-change: opacity;
}

.will-change-auto {
  will-change: auto;
}

/* Optimize common animations */
.animate-spin {
  animation: spin 1s linear infinite;
  will-change: transform;
}

.animate-pulse {
  animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  will-change: opacity;
}

.animate-bounce {
  animation: bounce 1s infinite;
  will-change: transform;
}

/* Smooth hover effects with GPU acceleration */
.group:hover .group-hover\:translate-x-1 {
  transform: translateX(0.25rem) translateZ(0);
}

/* Optimize animations */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20px) translateZ(0);
  }

  to {
    opacity: 1;
    transform: translateY(0) translateZ(0);
  }
}

.animate-fade-in {
  animation: fadeIn 0.3s ease-out;
}

/* Ultra-fast animations ONLY for section classes that need it */
/* Removed global 0.1s override — it killed hover transitions */

/* Disable animations on scroll */
@media (prefers-reduced-motion: no-preference) {
  .scrolling * {
    animation: none !important;
    transition: none !important;
  }
}

/* Keep only essential smooth transitions */
.nav-link,
.button,
.card {
  transition: all 0.15s ease-out !important;
  transform: translateZ(0);
}

/* Optimize scrolling */
.scroll-smooth {
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
}

/* Better Typography Hierarchy */
h1,
h2,
h3,
h4,
h5,
h6 {
  color: rgb(var(--text));
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -0.02em;
}

h1 {
  font-size: 2.5rem;
  font-weight: 800;
}

h2 {
  font-size: 2rem;
  font-weight: 700;
}

h3 {
  font-size: 1.5rem;
}

p {
  color: rgb(var(--text-secondary));
  line-height: 1.7;
}

/* Code/Terminal Font */
code,
pre,
.code-font {
  font-family: 'JetBrains Mono', 'Fira Code', 'Monaco', 'Consolas', monospace;
}

/* Enhanced Focus States */
button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible,
a:focus-visible {
  outline: 3px solid rgba(var(--primary), 0.4);
  outline-offset: 2px;
  box-shadow: 0 0 0 4px var(--glow-primary);
}

/* Professional Scrollbar */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: rgb(var(--bg));
}

::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, rgba(var(--primary), 0.6), rgba(var(--accent), 0.6));
  border-radius: 4px;
  transition: background 0.3s ease;
}

::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(180deg, rgb(var(--primary)), rgb(var(--accent)));
}

/* Intersection Observer optimization */
.lazy-load {
  opacity: 0;
  transform: translateY(20px) translateZ(0);
  transition: opacity 0.3s ease-out, transform 0.3s ease-out;
}

.lazy-load.loaded {
  opacity: 1;
  transform: translateY(0) translateZ(0);
}

/* Virtual list optimization */
.virtual-item {
  contain: layout style paint;
  will-change: transform;
  transform: translateZ(0);
}

/* Grid performance optimization */
.grid {
  contain: layout;
}

.grid>* {
  contain: layout style paint;
  transform: translateZ(0);
}

/* Optimize large lists */
.virtual-grid {
  contain: strict;
  will-change: scroll-position;
}

.virtual-grid-item {
  contain: layout style paint;
  will-change: transform;
  transform: translateZ(0);
}

/* Optimize images */
img {
  will-change: opacity;
  contain: layout;
}

img[loading="lazy"] {
  content-visibility: auto;
}

/* Optimize forms */
input,
textarea,
select {
  will-change: border-color, box-shadow;
  contain: layout style;
}

/* Optimize buttons */
button {
  will-change: background-color, transform;
  contain: layout style;
  transform: translateZ(0);
}

.card:hover {
  transform: translateY(-2px) translateZ(0);
}

/* Loading states */
.loading {
  background: linear-gradient(90deg, #334155 25%, #475569 50%, #334155 75%);
  background-size: 200% 100%;
  animation: loading 1.5s infinite;
}

@keyframes loading {
  0% {
    background-position: 200% 0;
  }

  100% {
    background-position: -200% 0;
  }
}

/* Responsive improvements */
@media (max-width: 768px) {
  body {
    font-size: 14px;
  }

  .container {
    padding-left: 1rem;
    padding-right: 1rem;
  }
}

/* High contrast mode support */
@media (prefers-contrast: high) {
  .glass-effect {
    background: rgba(15, 23, 42, 0.9);
    border: 2px solid rgba(56, 189, 248, 0.8);
  }
}

/* Reduced motion support */
@media (prefers-reduced-motion: reduce) {

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
    transform: none !important;
  }

  html {
    scroll-behavior: auto;
  }
}

/* Performance hints for browsers */
.container {
  contain: layout;
}

.section {
  contain: layout style;
}

/* Optimize font rendering */
@font-face {
  font-display: swap;
}

/* Critical performance optimizations */
.performance-optimized {
  transform: translateZ(0);
  will-change: transform;
  backface-visibility: hidden;
  perspective: 1000px;
  contain: layout style paint;
}

/* Page-specific optimizations */
.page-container {
  contain: layout;
  will-change: scroll-position;
}

.section {
  contain: layout style;
}

.component {
  contain: layout style paint;
  transform: translateZ(0);
}

/* Optimize navigation */
.nav-link {
  will-change: color, background-color;
  contain: layout style;
  transform: translateZ(0);
}

/* Optimize modals and overlays */
.modal,
.overlay {
  will-change: opacity, transform;
  contain: layout style paint;
  transform: translateZ(0);
}

/* Optimize tooltips */
.tooltip {
  will-change: opacity, transform;
  contain: layout style paint;
  transform: translateZ(0);
}

/* Content visibility for off-screen content */
.lazy-content {
  content-visibility: auto;
  contain-intrinsic-size: 200px;
}

/* Optimize tables */
table {
  contain: layout;
}

tbody tr {
  contain: layout style;
}

/* Optimize lists */
ul,
ol {
  contain: layout;
}

li {
  contain: layout style;
  transform: translateZ(0);
}

/* ========================================
   SMOOTH PAGE TRANSITIONS (No Flicker)
   ======================================== */

/* Smooth fade-in for all pages - replaces Framer Motion */
main>div {
  animation: smoothPageEntry 0.15s ease-out;
}

@keyframes smoothPageEntry {
  from {
    opacity: 0.92;
  }

  to {
    opacity: 1;
  }
}

/* Prevent any flash during navigation */
.page-container,
main {
  background-color: rgb(8, 12, 16);
  min-height: 100vh;
}

/* Ensure smooth transitions without layout shift */
/* ==========================================
   CYBERVERSE REDESIGN — CYBERPUNK DESIGN SYSTEM
   ========================================== */

/* ── Typography ── */
.cv-heading {
  font-family: 'Orbitron', 'Inter', sans-serif;
  letter-spacing: 0.04em;
}

/* ── Gradient text ── */
.cv-gradient-text {
  background: linear-gradient(90deg, #00F5FF, #8B5CF6, #39FF14);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-weight: 700;
}

.cv-gradient-animate {
  background: linear-gradient(270deg, #00F5FF, #8B5CF6, #39FF14, #00F5FF);
  background-size: 300% 100%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: cv-gradient-shift 5s ease infinite;
  font-weight: 800;
}

@keyframes cv-gradient-shift {
  0%   { background-position: 0% 50%; }
  50%  { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* ── Home container ── */
.cv-home {
  background: #0B0F1A;
  min-height: 100vh;
  overflow-x: hidden;
}
/* ─────────── NAVBAR (COMPACT & AGGRESSIVE) ─────────── */
.cv-navbar {
  height: 64px;
  background: linear-gradient(to bottom, 
    rgba(8, 12, 16, 0.95) 0%, 
    rgba(5, 7, 10, 0.98) 100%
  );
  border-bottom: 1px solid rgba(0, 245, 255, 0.2);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  transition: all 0.2s ease;
}

.cv-navbar-scrolled {
  background: rgba(4, 6, 8, 0.98);
  border-bottom: 1px solid rgba(0, 245, 255, 0.35);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
}

/* Logo */
.cv-logo-shield {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 245, 255, 0.05);
  border: 1px solid rgba(0, 245, 255, 0.2);
  border-radius: 4px;
}

.cv-logo-text {
  font-family: 'Orbitron', sans-serif;
  font-size: 0.95rem;
  font-weight: 900;
  color: #fff;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  transition: text-shadow 0.2s ease;
}

.cv-logo-text .text-primary {
  color: #00F5FF;
  text-shadow: 0 0 10px rgba(0, 245, 255, 0.5);
}

/* Nav Links */
.cv-nav-link {
  font-family: 'Inter', sans-serif;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #94A3B8;
  padding: 0 16px;
  height: 64px;
  display: flex;
  align-items: center;
  position: relative;
  transition: all 0.2s ease;
}

.cv-nav-link:hover {
  color: #fff;
}

.cv-nav-link::after {
  content: '';
  position: absolute;
  bottom: 0px;
  left: 0;
  width: 100%;
  height: 2px;
  background: #00F5FF;
  box-shadow: 0 0 12px rgba(0, 245, 255, 0.8);
  transform: scaleX(0);
  transition: transform 0.2s ease;
}

.cv-nav-link:hover::after,
.cv-nav-link-active::after {
  transform: scaleX(1);
}

.cv-nav-link-active {
  color: #fff !important;
  background: linear-gradient(to top, rgba(0, 245, 255, 0.08), transparent);
}

/* Gamified Status Cluster */
.cv-stats-cluster {
  display: flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.5);
  border: 1px solid rgba(0, 245, 255, 0.15);
  border-radius: 4px;
  padding: 4px 10px;
  gap: 10px;
}

.cv-stat-chip {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.7rem;
  font-weight: 800;
  color: #fff;
  font-family: 'Inter', sans-serif;
}

.cv-stat-divider {
  width: 1px;
  height: 12px;
  background: rgba(255, 255, 255, 0.1);
}

/* Premium Button (Outline) */
.cv-premium-outline-btn {
  height: 32px;
  padding: 0 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.7rem;
  font-weight: 900;
  letter-spacing: 0.05em;
  color: #fff;
  background: rgba(0, 0, 0, 0.2);
  border-radius: 4px;
  position: relative;
  transition: all 0.2s ease;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.cv-premium-outline-btn::before {
  content: '';
  position: absolute;
  inset: -1px;
  padding: 1px;
  border-radius: 4px;
  background: linear-gradient(90deg, #00F5FF, #8B5CF6);
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  opacity: 0.6;
}

.cv-premium-outline-btn:hover {
  background: rgba(0, 245, 255, 0.05);
  box-shadow: 0 0 15px rgba(0, 245, 255, 0.15);
}

.cv-premium-outline-btn:hover::before {
  opacity: 1;
}

/* Search Btn */
.cv-nav-search-btn {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #94A3B8;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 4px;
  transition: all 0.2s ease;
}

.cv-nav-search-btn:hover {
  color: #fff;
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(255, 255, 255, 0.2);
}

.cv-btn-primary-sm {
  padding: 6px 18px;
  border-radius: 8px;
  background: linear-gradient(135deg, #00F5FF, #8B5CF6);
  color: #0B0F1A;
  font-size: 0.85rem;
  font-weight: 700;
  transition: box-shadow 0.3s ease, transform 0.2s ease;
  border: none;
}
.cv-btn-primary-sm:hover {
  box-shadow: 0 0 20px rgba(0,245,255,0.35);
  transform: translateY(-1px) scale(1.02);
}

/* ─────────── SHARED LAYOUT ─────────── */
.cv-section-inner {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 1.5rem;
}

.cv-section-header {
  text-align: center;
  margin-bottom: 3rem;
}

.cv-section-title {
  font-family: 'Orbitron', sans-serif;
  font-size: clamp(1.5rem, 3vw, 2.2rem);
  font-weight: 700;
  color: #F0F6FC;
  letter-spacing: 0.04em;
  margin-bottom: 0.75rem;
}

.cv-section-sub {
  color: #94A3B8;
  font-size: 1rem;
  max-width: 560px;
  margin: 0 auto;
  line-height: 1.65;
}

/* ─────────── HERO ─────────── */
.cv-hero {
  position: relative;
  padding: 5rem 1.5rem 4rem;
  overflow: hidden;
}

.cv-hero-glow {
  position: absolute;
  top: -120px;
  left: 50%;
  transform: translateX(-50%);
  width: 800px;
  height: 600px;
  background: radial-gradient(ellipse at center,
    rgba(0,245,255,0.07) 0%,
    rgba(139,92,246,0.06) 40%,
    transparent 70%);
  pointer-events: none;
}

/* Very lightweight static grid */
.cv-hero-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(0,245,255,0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,245,255,0.04) 1px, transparent 1px);
  background-size: 60px 60px;
  pointer-events: none;
  mask-image: radial-gradient(ellipse at center, black 20%, transparent 80%);
  -webkit-mask-image: radial-gradient(ellipse at center, black 20%, transparent 80%);
}

.cv-hero-inner {
  position: relative;
  max-width: 1100px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: center;
}

.cv-hero-left {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.cv-hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 16px;
  border-radius: 999px;
  background: rgba(0,245,255,0.08);
  border: 1px solid rgba(0,245,255,0.25);
  color: #00F5FF;
  font-size: 0.8rem;
  font-weight: 600;
  width: fit-content;
}

.cv-hero-heading {
  font-family: 'Orbitron', sans-serif;
  font-size: clamp(2rem, 5vw, 3.2rem);
  font-weight: 800;
  color: #F0F6FC;
  line-height: 1.15;
  letter-spacing: 0.02em;
}

.cv-hero-sub {
  color: #94A3B8;
  font-size: 1.05rem;
  line-height: 1.7;
  max-width: 440px;
}

.cv-hero-cta {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

/* Primary CTA */
.cv-btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 28px;
  border-radius: 10px;
  background: linear-gradient(135deg, #00F5FF, #8B5CF6);
  color: #0B0F1A;
  font-weight: 700;
  font-size: 0.95rem;
  transition: box-shadow 0.3s ease, transform 0.2s ease;
  border: none;
  text-decoration: none;
}
.cv-btn-primary:hover {
  box-shadow: 0 0 24px rgba(0,245,255,0.4), 0 6px 18px rgba(0,0,0,0.3);
  transform: translateY(-2px) scale(1.02);
}

/* Secondary CTA */
.cv-btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 28px;
  border-radius: 10px;
  background: transparent;
  border: 1px solid rgba(139,92,246,0.45);
  color: #8B5CF6;
  font-weight: 600;
  font-size: 0.95rem;
  transition: background 0.3s ease, box-shadow 0.3s ease, transform 0.2s ease;
  text-decoration: none;
}
.cv-btn-secondary:hover {
  background: rgba(139,92,246,0.1);
  box-shadow: 0 0 18px rgba(139,92,246,0.3);
  transform: translateY(-2px);
}

/* Outline CTA */
.cv-btn-outline {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 10px 24px;
  border-radius: 8px;
  background: transparent;
  border: 1px solid rgba(0,245,255,0.3);
  color: #00F5FF;
  font-weight: 600;
  font-size: 0.9rem;
  transition: background 0.3s ease, box-shadow 0.3s ease, transform 0.2s ease;
  text-decoration: none;
  margin-top: 0.5rem;
  width: fit-content;
}
.cv-btn-outline:hover {
  background: rgba(0,245,255,0.07);
  box-shadow: 0 0 14px rgba(0,245,255,0.2);
  transform: translateY(-1px);
}

/* ─── Dashboard Preview Card ─── */
.cv-hero-right {
  display: flex;
  justify-content: center;
  align-items: center;
}

.cv-dash-card {
  background: rgba(17,24,39,0.75);
  border: 1px solid rgba(0,245,255,0.18);
  border-radius: 16px;
  padding: 1.25rem;
  width: 100%;
  max-width: 380px;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: 0 8px 32px rgba(0,0,0,0.4), 0 0 0 1px rgba(0,245,255,0.06);
  animation: cv-float 4s ease-in-out infinite;
  will-change: transform;
}

@keyframes cv-float {
  0%,100% { transform: translateY(0); }
  50%      { transform: translateY(-6px); }
}

.cv-dash-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 1rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}

.cv-dash-icon { color: #00F5FF; }

.cv-dash-title {
  font-family: 'Orbitron', sans-serif;
  font-size: 0.75rem;
  color: #00F5FF;
  font-weight: 600;
  letter-spacing: 0.05em;
  flex: 1;
}

.cv-dash-dots {
  display: flex;
  gap: 5px;
}
.cv-dash-dots span {
  display: block;
  width: 10px;
  height: 10px;
  border-radius: 50%;
}

/* Terminal text */
.cv-dash-terminal {
  font-family: 'JetBrains Mono', 'Fira Code', monospace;
  font-size: 0.73rem;
  line-height: 1.8;
  margin-bottom: 1rem;
}
.cv-term-prompt { color: #39FF14; margin-right: 6px; font-weight: 700; }
.cv-term-cmd    { color: #E2E8F0; }
.cv-term-success { color: #39FF14; }
.cv-term-muted  { color: #64748B; }
.cv-term-info   { color: #94A3B8; }
.cv-term-warn   { color: #FACC15; }

.cv-dash-stats-row {
  display: flex;
  gap: 0.75rem;
  padding-top: 0.75rem;
  border-top: 1px solid rgba(255,255,255,0.06);
}

.cv-mini-stat {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 0.75rem;
  color: #94A3B8;
  font-weight: 600;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.07);
  padding: 4px 10px;
  border-radius: 6px;
}

/* ─────────── STATS SECTION ─────────── */
.cv-stats-section {
  padding: 4rem 1.5rem;
}

.cv-stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

.cv-stat-card {
  --accent-color: #00F5FF;
  background: rgba(17,24,39,0.6);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 14px;
  padding: 1.75rem 1.5rem;
  text-align: center;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  position: relative;
  overflow: hidden;
  will-change: transform;
}

.cv-stat-card::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 14px;
  border: 1px solid var(--accent-color);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.cv-stat-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 0 24px rgba(0,0,0,0.4), 0 0 0 1px rgba(255,255,255,0.05);
}
.cv-stat-card:hover::before { opacity: 0.25; }

.cv-stat-icon {
  font-size: 1.8rem;
  margin-bottom: 0.5rem;
  display: block;
}

.cv-stat-value {
  font-family: 'Orbitron', sans-serif;
  font-size: clamp(1.6rem, 4vw, 2.2rem);
  font-weight: 800;
  color: var(--accent-color);
  letter-spacing: 0.03em;
  margin-bottom: 0.25rem;
  text-shadow: 0 0 12px var(--accent-color);
}

.cv-stat-label {
  color: #94A3B8;
  font-size: 0.82rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 0.75rem;
}

.cv-xp-bar-wrap {
  height: 4px;
  background: rgba(255,255,255,0.07);
  border-radius: 999px;
  overflow: hidden;
  margin-bottom: 0.4rem;
}

.cv-xp-bar {
  --xp-pct: 50%;
  --bar-color: #00F5FF;
  height: 100%;
  width: var(--xp-pct);
  background: var(--bar-color);
  border-radius: 999px;
  box-shadow: 0 0 6px var(--bar-color);
}

.cv-xp-label {
  color: #64748B;
  font-size: 0.7rem;
  font-weight: 500;
}

/* ─────────── FEATURES SECTION ─────────── */
.cv-features-section {
  padding: 4rem 1.5rem;
}

.cv-features-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.25rem;
}

.cv-feature-card {
  --feat-color: #00F5FF;
  background: rgba(17,24,39,0.6);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 14px;
  padding: 1.5rem 1.25rem;
  transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  position: relative;
  overflow: hidden;
  will-change: transform;
}

.cv-feature-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--feat-color), transparent);
  opacity: 0;
  transition: opacity 0.3s ease;
  border-radius: 14px 14px 0 0;
}

.cv-feature-card:hover {
  transform: perspective(800px) rotateX(2deg) rotateY(-1deg) translateY(-4px);
  box-shadow: 0 12px 32px rgba(0,0,0,0.4);
  border-color: rgba(255,255,255,0.1);
}
.cv-feature-card:hover::before { opacity: 1; }

.cv-feature-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1rem;
}

.cv-feature-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.08);
  color: var(--feat-color);
  transition: box-shadow 0.3s ease;
}

.cv-feature-card:hover .cv-feature-icon-wrap {
  box-shadow: 0 0 16px var(--feat-color);
}

.cv-feature-icon {
  color: var(--feat-color);
}

.cv-xp-badge {
  font-size: 0.68rem;
  font-weight: 700;
  padding: 3px 9px;
  border-radius: 6px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.1);
  color: var(--feat-color);
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.cv-feature-title {
  font-family: 'Orbitron', sans-serif;
  font-size: 0.9rem;
  font-weight: 700;
  color: #E2E8F0;
  letter-spacing: 0.04em;
  margin-bottom: 0.6rem;
}

.cv-feature-desc {
  color: #64748B;
  font-size: 0.82rem;
  line-height: 1.6;
}

/* ─────────── LEADERBOARD SECTION ─────────── */
.cv-lb-section {
  padding: 4rem 1.5rem;
}

.cv-lb-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: center;
}

.cv-lb-card {
  background: rgba(17,24,39,0.7);
  border: 1px solid rgba(0,245,255,0.14);
  border-radius: 14px;
  padding: 1.5rem;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: 0 0 0 1px rgba(255,255,255,0.03);
}

.cv-lb-card-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 1.25rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid rgba(255,255,255,0.06);
  font-weight: 600;
  color: #CBD5E1;
  font-size: 0.85rem;
}

.cv-lb-live {
  margin-left: auto;
  font-size: 0.65rem;
  font-weight: 700;
  color: #39FF14;
  letter-spacing: 0.1em;
  padding: 2px 8px;
  border-radius: 4px;
  background: rgba(57,255,20,0.1);
  border: 1px solid rgba(57,255,20,0.25);
  text-shadow: 0 0 6px #39FF14;
}

.cv-leader-row {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 0.85rem 0;
  border-bottom: 1px solid rgba(255,255,255,0.04);
  transition: background 0.2s ease;
  border-radius: 8px;
  padding-left: 4px;
  padding-right: 4px;
}
.cv-leader-row:last-child { border-bottom: none; }
.cv-leader-row:hover { background: rgba(255,255,255,0.03); }

.cv-rank-badge {
  font-size: 1.4rem;
  width: 36px;
  text-align: center;
}

.cv-leader-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
  flex: 1;
}

.cv-leader-name {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.88rem;
  font-weight: 600;
  color: #E2E8F0;
}

.cv-leader-level {
  font-size: 0.72rem;
  color: #64748B;
  font-weight: 500;
}

.cv-leader-xp {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 0.78rem;
  font-weight: 700;
  font-family: 'Orbitron', monospace;
  letter-spacing: 0.02em;
}

/* ─────────── PREMIUM SECTION ─────────── */
.cv-premium-section {
  padding: 4rem 1.5rem 5rem;
}

.cv-premium-card {
  position: relative;
  background: linear-gradient(135deg, #0D1020, #111319);
  border: 1px solid rgba(250,204,21,0.3);
  border-radius: 20px;
  padding: 3.5rem 2.5rem;
  text-align: center;
  overflow: hidden;
  box-shadow: 0 0 60px rgba(250,204,21,0.06), 0 20px 60px rgba(0,0,0,0.5);
}

.cv-premium-glow {
  position: absolute;
  top: -100px;
  left: 50%;
  transform: translateX(-50%);
  width: 600px;
  height: 400px;
  background: radial-gradient(ellipse at center, rgba(250,204,21,0.08) 0%, transparent 60%);
  pointer-events: none;
}

.cv-premium-crown {
  color: #FACC15;
  margin: 0 auto 1.25rem;
  display: block;
  filter: drop-shadow(0 0 10px rgba(250,204,21,0.5));
}

.cv-premium-title {
  font-family: 'Orbitron', sans-serif;
  font-size: clamp(1.4rem, 3vw, 2rem);
  font-weight: 800;
  color: #F0F6FC;
  letter-spacing: 0.04em;
  margin-bottom: 1rem;
}

.cv-premium-sub {
  color: #94A3B8;
  font-size: 1rem;
  max-width: 520px;
  margin: 0 auto 2rem;
  line-height: 1.7;
}

.cv-premium-benefits {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  max-width: 460px;
  margin: 0 auto 2.5rem;
  text-align: left;
}

.cv-premium-benefit {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 0.9rem;
  color: #CBD5E1;
  font-weight: 500;
}

.cv-benefit-check { color: #FACC15; flex-shrink: 0; }

/* Gold CTA button */
.cv-btn-gold {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 13px 34px;
  border-radius: 10px;
  background: linear-gradient(135deg, #FACC15, #F59E0B);
  color: #0B0F1A;
  font-weight: 700;
  font-size: 0.95rem;
  border: none;
  transition: box-shadow 0.3s ease, transform 0.2s ease;
  text-decoration: none;
  margin-bottom: 1rem;
  font-family: 'Inter', sans-serif;
}
.cv-btn-gold:hover {
  box-shadow: 0 0 30px rgba(250,204,21,0.5), 0 8px 20px rgba(0,0,0,0.3);
  transform: translateY(-2px) scale(1.02);
}

.cv-premium-note {
  color: #64748B;
  font-size: 0.78rem;
  margin-top: 0;
}

/* ─────────── RESPONSIVE ─────────── */
@media (max-width: 1024px) {
  .cv-features-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 768px) {
  .cv-hero {
    padding: 3rem 1.25rem 2.5rem;
  }
  .cv-hero-inner {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .cv-hero-right {
    order: -1;
  }
  .cv-dash-card {
    max-width: 100%;
    animation: none;
    transform: none;
  }
  .cv-hero-badge {
    font-size: 0.72rem;
  }
  .cv-stats-grid {
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  .cv-features-grid {
    grid-template-columns: 1fr;
  }
  .cv-lb-inner {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .cv-lb-left {
    text-align: center;
  }
  .cv-lb-left .cv-section-header {
    text-align: center;
  }
  .cv-lb-left .cv-btn-outline {
    margin: 0 auto;
  }
  .cv-premium-card {
    padding: 2.5rem 1.5rem;
  }
  .cv-stat-card:hover {
    box-shadow: none;
  }
  .cv-gamified-pill {
    display: none;
  }
  .cv-section-inner {
    padding: 0 1rem;
  }
}

@media (max-width: 480px) {
  .cv-stats-grid {
    grid-template-columns: 1fr;
  }
  .cv-hero-cta {
    flex-direction: column;
  }
  .cv-btn-primary,
  .cv-btn-secondary {
    justify-content: center;
    width: 100%;
  }
  .cv-feature-card:hover {
    transform: translateY(-3px);
  }
}

/* ==========================================
   CYBERVERSE FOOTER — CYBERPUNK REDESIGN
   ========================================== */

.cv-footer {
  position: relative;
  background: #080C14;
  overflow: hidden;
}

/* Neon top border */
.cv-footer-topline {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg,
    transparent 0%,
    #00F5FF 30%,
    #8B5CF6 60%,
    #39FF14 80%,
    transparent 100%
  );
  opacity: 0.6;
}

/* Static grid overlay */
.cv-footer-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(0,245,255,0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,245,255,0.025) 1px, transparent 1px);
  background-size: 50px 50px;
  pointer-events: none;
  mask-image: linear-gradient(to bottom, transparent 0%, black 20%, black 80%, transparent 100%);
  -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 20%, black 80%, transparent 100%);
}

/* Main content wrapper */
.cv-footer-inner {
  position: relative;
  max-width: 1100px;
  margin: 0 auto;
  padding: 3.5rem 1.5rem 2.5rem;
  display: grid;
  grid-template-columns: 2.2fr 1fr 1fr 1fr;
  gap: 3rem;
}

/* ── Brand column ── */
.cv-footer-brand {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.cv-footer-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  width: fit-content;
}

.cv-footer-logo-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border-radius: 8px;
  background: linear-gradient(135deg, rgba(0,245,255,0.12), rgba(139,92,246,0.12));
  border: 1px solid rgba(0,245,255,0.28);
  flex-shrink: 0;
}

.cv-footer-logo-text {
  font-family: 'Orbitron', sans-serif;
  font-size: 1.05rem;
  font-weight: 700;
  background: linear-gradient(90deg, #00F5FF, #8B5CF6);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: 0.06em;
}

.cv-footer-tagline {
  color: #64748B;
  font-size: 0.82rem;
  line-height: 1.7;
  max-width: 280px;
}

/* Mini stats row */
.cv-footer-mini-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
}

.cv-footer-mini-stat {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 0.72rem;
  color: #94A3B8;
  font-weight: 500;
  padding: 4px 10px;
  border-radius: 6px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.07);
}

/* Social links */
.cv-footer-social-block {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.cv-footer-social-label {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.75rem;
  font-weight: 600;
  color: #94A3B8;
  text-transform: uppercase;
  letter-spacing: 0.07em;
}

.cv-footer-socials {
  display: flex;
  gap: 0.5rem;
}

.cv-footer-social-btn {
  --social-color: #00F5FF;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border-radius: 8px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.09);
  color: #94A3B8;
  transition: color 0.3s ease, background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease, transform 0.2s ease;
}

.cv-footer-social-btn:hover {
  color: var(--social-color);
  background: rgba(255,255,255,0.07);
  border-color: var(--social-color);
  box-shadow: 0 0 12px var(--social-color);
  transform: translateY(-2px) scale(1.08);
}

/* ── Link columns ── */
.cv-footer-links-col {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.cv-footer-col-title {
  display: flex;
  align-items: center;
  gap: 7px;
  font-family: 'Orbitron', sans-serif;
  font-size: 0.78rem;
  font-weight: 700;
  color: #E2E8F0;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 0.25rem;
  /* Reset heading default styles */
  line-height: 1.4;
}

.cv-footer-link-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
}

.cv-footer-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.82rem;
  color: #64748B;
  text-decoration: none;
  font-weight: 500;
  transition: color 0.3s ease, text-shadow 0.3s ease;
}

.cv-footer-link-arrow {
  opacity: 0;
  transform: translateX(-4px);
  transition: opacity 0.3s ease, transform 0.3s ease;
  color: #00F5FF;
  flex-shrink: 0;
}

.cv-footer-link:hover {
  color: #00F5FF;
  text-shadow: 0 0 8px rgba(0,245,255,0.3);
}

.cv-footer-link:hover .cv-footer-link-arrow {
  opacity: 1;
  transform: translateX(0);
}

/* purple variant */
.cv-footer-link--purple:hover {
  color: #8B5CF6;
  text-shadow: 0 0 8px rgba(139,92,246,0.35);
}
.cv-footer-link--purple:hover .cv-footer-link-arrow {
  color: #8B5CF6;
}

/* gold variant */
.cv-footer-link--gold:hover {
  color: #FACC15;
  text-shadow: 0 0 8px rgba(250,204,21,0.35);
}
.cv-footer-link--gold:hover .cv-footer-link-arrow {
  color: #FACC15;
}

/* ── Bottom bar ── */
.cv-footer-bottom {
  position: relative;
  border-top: 1px solid rgba(255,255,255,0.06);
}

.cv-footer-bottom-inner {
  max-width: 1100px;
  margin: 0 auto;
  padding: 1.25rem 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
}

.cv-footer-bottom-left {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.cv-footer-version {
  padding: 2px 10px;
  border-radius: 999px;
  background: rgba(0,245,255,0.08);
  border: 1px solid rgba(0,245,255,0.22);
  color: #00F5FF;
  font-size: 0.7rem;
  font-family: 'Orbitron', sans-serif;
  font-weight: 600;
  letter-spacing: 0.06em;
}

.cv-footer-copy {
  color: #475569;
  font-size: 0.78rem;
}

.cv-footer-bottom-center {
  display: flex;
  justify-content: center;
}

.cv-footer-badge {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 5px 14px;
  border-radius: 999px;
  background: rgba(0,245,255,0.05);
  border: 1px solid rgba(0,245,255,0.18);
  color: #00F5FF;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.04em;
}

.cv-footer-bottom-right {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.cv-footer-contact {
  display: flex;
  align-items: center;
  gap: 5px;
  color: #64748B;
  font-size: 0.78rem;
  text-decoration: none;
  transition: color 0.3s ease;
}
.cv-footer-contact:hover {
  color: #00F5FF;
}

.cv-footer-divider {
  width: 1px;
  height: 16px;
  background: rgba(255,255,255,0.1);
  flex-shrink: 0;
}

.cv-footer-built {
  display: flex;
  align-items: center;
  gap: 5px;
  color: #475569;
  font-size: 0.75rem;
}

/* ── Footer Responsive ── */
@media (max-width: 1024px) {
  .cv-footer-inner {
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
  }
  .cv-footer-brand {
    grid-column: 1 / -1;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .cv-footer-tagline {
    max-width: 100%;
  }
}

@media (max-width: 768px) {
  .cv-footer-inner {
    grid-template-columns: 1fr 1fr;
    padding: 2.5rem 1.25rem 2rem;
    gap: 2rem;
  }
  .cv-footer-brand {
    grid-column: 1 / -1;
    flex-direction: column;
  }
  .cv-footer-bottom-inner {
    flex-direction: column;
    text-align: center;
    gap: 0.75rem;
  }
  .cv-footer-bottom-left,
  .cv-footer-bottom-right {
    justify-content: center;
    flex-wrap: wrap;
  }
  .cv-footer-built {
    flex-wrap: wrap;
    justify-content: center;
  }
}

@media (max-width: 480px) {
  .cv-footer-inner {
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }
  .cv-footer-mini-stats {
    flex-direction: row;
  }
}


/* ==========================================
   AUTH PAGES v2 — CENTERED CARD (HackTheBox Style)
   ========================================== */

/* ── Full-page dark background ── */
.auth2-bg {
  min-height: 100vh;
  background: #080C14;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem 1.25rem;
  position: relative;
  overflow: hidden;
}

/* Radial glow orbs */
.auth2-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(80px);
}
.auth2-glow--cyan {
  top: -120px;
  left: 50%;
  transform: translateX(-50%);
  width: 700px;
  height: 500px;
  background: radial-gradient(ellipse,
    rgba(0,245,255,0.1) 0%,
    rgba(139,92,246,0.07) 50%,
    transparent 70%);
}
.auth2-glow--purple {
  bottom: -150px;
  right: -100px;
  width: 500px;
  height: 500px;
  background: radial-gradient(ellipse,
    rgba(139,92,246,0.12) 0%,
    transparent 65%);
}
.auth2-glow--bottom {
  bottom: -150px;
  left: -100px;
  right: auto;
  background: radial-gradient(ellipse,
    rgba(0,245,255,0.08) 0%,
    transparent 65%);
}

/* Static cyber grid */
.auth2-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(0,245,255,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,245,255,0.03) 1px, transparent 1px);
  background-size: 55px 55px;
  pointer-events: none;
  mask-image: radial-gradient(ellipse at 50% 40%, black 20%, transparent 75%);
  -webkit-mask-image: radial-gradient(ellipse at 50% 40%, black 20%, transparent 75%);
}

/* ── Card wrapper ── */
.auth2-card-wrap {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.25rem;
  width: 100%;
  max-width: 460px;
}

/* Logo above card */
.auth2-logo {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  text-decoration: none;
}
.auth2-logo-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border-radius: 8px;
  background: linear-gradient(135deg, rgba(0,245,255,0.14), rgba(139,92,246,0.14));
  border: 1px solid rgba(0,245,255,0.28);
}
.auth2-logo-icon--purple {
  background: linear-gradient(135deg, rgba(139,92,246,0.16), rgba(0,245,255,0.1));
  border-color: rgba(139,92,246,0.32);
}
.auth2-logo-text {
  font-family: 'Orbitron', sans-serif;
  font-size: 1.05rem;
  font-weight: 700;
  background: linear-gradient(90deg, #00F5FF, #8B5CF6);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: 0.06em;
}

/* ── The card itself ── */
.auth2-card {
  width: 100%;
  background: rgba(15, 20, 35, 0.75);
  border: 1px solid rgba(0,245,255,0.12);
  border-radius: 18px;
  padding: 2.25rem 2rem;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow:
    0 0 0 1px rgba(255,255,255,0.04),
    0 24px 64px rgba(0,0,0,0.5),
    0 0 60px rgba(0,245,255,0.04);
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

/* Wider card for register (2-col form) */
.auth2-card--wide {
  max-width: 100%;
}

/* Card header */
.auth2-card-header {
  text-align: center;
}

.auth2-timeout-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.72rem;
  font-weight: 700;
  color: #FACC15;
  padding: 4px 12px;
  border-radius: 999px;
  background: rgba(250,204,21,0.08);
  border: 1px solid rgba(250,204,21,0.25);
  margin-bottom: 0.6rem;
}

.auth2-card-title {
  font-family: 'Orbitron', sans-serif;
  font-size: 1.55rem;
  font-weight: 800;
  color: #F0F6FC;
  letter-spacing: 0.04em;
  margin-bottom: 0.4rem;
}

.auth2-card-sub {
  color: #64748B;
  font-size: 0.85rem;
  line-height: 1.5;
}

/* Google button */
.auth2-google-wrap {
  display: flex;
  justify-content: center;
}
.auth2-google-wrap > div { width: 100% !important; }

/* Divider */
.auth2-divider {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}
.auth2-divider-line {
  flex: 1;
  height: 1px;
  background: rgba(255,255,255,0.07);
}
.auth2-divider-text {
  color: #334155;
  font-size: 0.72rem;
  white-space: nowrap;
  font-weight: 500;
}

/* Form */
.auth2-form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

/* 2-col grid for register */
.auth2-form--grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 1rem;
  row-gap: 1rem;
}

.auth2-field {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.auth2-label {
  font-size: 0.72rem;
  font-weight: 700;
  color: #94A3B8;
  letter-spacing: 0.07em;
  text-transform: uppercase;
}

.auth2-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.auth2-forgot {
  font-size: 0.72rem;
  color: #00F5FF;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  font-weight: 500;
  transition: text-shadow 0.2s ease;
}
.auth2-forgot:hover { text-shadow: 0 0 8px rgba(0,245,255,0.5); }

.auth2-input-wrap {
  position: relative;
}

.auth2-input {
  width: 100%;
  height: 44px;
  padding: 0 42px 0 13px !important;
  background: rgba(255,255,255,0.04) !important;
  border: 1px solid rgba(255,255,255,0.09) !important;
  border-radius: 10px;
  color: #E2E8F0 !important;
  font-size: 0.87rem;
  font-family: 'Inter', sans-serif;
  transition: border-color 0.25s ease, box-shadow 0.25s ease !important;
}
.auth2-input::placeholder { color: #2D3748 !important; font-size: 0.8rem; }
.auth2-input:focus {
  outline: none;
  border-color: rgba(0,245,255,0.45) !important;
  box-shadow: 0 0 0 3px rgba(0,245,255,0.08) !important;
  background: rgba(0,245,255,0.02) !important;
}
.auth2-input--purple:focus {
  border-color: rgba(139,92,246,0.45) !important;
  box-shadow: 0 0 0 3px rgba(139,92,246,0.08) !important;
  background: rgba(139,92,246,0.02) !important;
}
.auth2-input--err { border-color: rgba(239,68,68,0.45) !important; }
.auth2-input--ok  { border-color: rgba(57,255,20,0.35) !important; }

/* standalone input (no wrap) */
.auth2-field > .auth2-input {
  padding-right: 13px !important;
}

.auth2-eye {
  position: absolute;
  right: 12px;
  top: 50%;
  transform: translateY(-50%);
  color: #334155;
  background: none;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  transition: color 0.2s ease;
}
.auth2-eye:hover { color: #94A3B8; }

/* Strength bar */
.auth2-strength {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-top: 3px;
}
.auth2-strength-bars { display: flex; gap: 3px; flex: 1; }
.auth2-strength-bar { height: 3px; flex: 1; border-radius: 999px; transition: background 0.3s ease; }
.auth2-strength-label { font-size: 0.65rem; font-weight: 700; white-space: nowrap; }

/* Match ok */
.auth2-match-ok {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 0.68rem;
  color: #39FF14;
  font-weight: 600;
  margin-top: 2px;
}

/* Error / Success */
.auth2-error {
  display: flex;
  align-items: flex-start;
  gap: 7px;
  padding: 9px 13px;
  background: rgba(239,68,68,0.07);
  border: 1px solid rgba(239,68,68,0.22);
  border-radius: 8px;
  color: #FCA5A5;
  font-size: 0.8rem;
  line-height: 1.5;
}
.auth2-success {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 9px 13px;
  background: rgba(57,255,20,0.06);
  border: 1px solid rgba(57,255,20,0.22);
  border-radius: 8px;
  color: #86EFAC;
  font-size: 0.8rem;
}
/* span full 2 cols in grid form */
.auth2-error--full,
.auth2-success--full { grid-column: 1 / -1; }

/* Submit button */
.auth2-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  height: 46px;
  border-radius: 10px;
  background: linear-gradient(135deg, #00F5FF, #8B5CF6);
  color: #080C14;
  font-weight: 700;
  font-size: 0.92rem;
  border: none;
  cursor: pointer;
  transition: box-shadow 0.3s ease, transform 0.2s ease, opacity 0.2s ease;
  font-family: 'Inter', sans-serif;
  grid-column: 1 / -1;
}
.auth2-submit:hover:not(:disabled) {
  box-shadow: 0 0 28px rgba(0,245,255,0.3), 0 6px 20px rgba(0,0,0,0.35);
  transform: translateY(-1px);
}
.auth2-submit:disabled { opacity: 0.65; cursor: not-allowed; }
.auth2-submit--purple { background: linear-gradient(135deg, #8B5CF6, #00F5FF); }
.auth2-submit--purple:hover:not(:disabled) {
  box-shadow: 0 0 28px rgba(139,92,246,0.3), 0 6px 20px rgba(0,0,0,0.35);
}
.auth2-submit--full { grid-column: 1 / -1; }

/* Button spinner */
.auth2-btn-spin { animation: auth2-spin 1s linear infinite; }
@keyframes auth2-spin { to { transform: rotate(360deg); } }

/* Terms */
.auth2-terms {
  font-size: 0.7rem;
  color: #334155;
  text-align: center;
  line-height: 1.6;
  grid-column: 1 / -1;
}
.auth2-terms--full { grid-column: 1 / -1; }
.auth2-terms-link { color: #8B5CF6; text-decoration: none; }
.auth2-terms-link:hover { text-decoration: underline; }

/* Switch */
.auth2-switch {
  text-align: center;
  font-size: 0.82rem;
  color: #475569;
}
.auth2-switch-link {
  color: #00F5FF;
  font-weight: 600;
  text-decoration: none;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  font-size: 0.82rem;
  transition: text-shadow 0.2s ease;
}
.auth2-switch-link:hover { text-shadow: 0 0 8px rgba(0,245,255,0.5); }

/* Trust badges row */
.auth2-badges {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  flex-wrap: wrap;
}
.auth2-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 0.7rem;
  color: #334155;
  font-weight: 500;
}

/* Loader / already-in screen */
.auth2-loader {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  color: #64748B;
  font-size: 0.88rem;
  text-align: center;
}
.auth2-spin-icon {
  width: 32px; height: 32px;
  color: #00F5FF;
  animation: auth2-spin 1s linear infinite;
}
.auth2-check-icon { width: 44px; height: 44px; color: #39FF14; }
.auth2-already-btn {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  margin-top: 0.5rem;
  padding: 9px 22px;
  border-radius: 8px;
  background: linear-gradient(135deg, #00F5FF, #8B5CF6);
  color: #080C14;
  font-weight: 700;
  text-decoration: none;
  font-size: 0.88rem;
  transition: box-shadow 0.3s ease;
}
.auth2-already-btn:hover { box-shadow: 0 0 20px rgba(0,245,255,0.35); }

/* ── RESPONSIVE ── */
@media (max-width: 640px) {
  .auth2-form--grid {
    grid-template-columns: 1fr;
  }
  .auth2-card {
    padding: 1.75rem 1.25rem;
    border-radius: 14px;
  }
  .auth2-card-title { font-size: 1.3rem; }
  .auth2-input { height: 42px; }
  .auth2-submit { height: 44px; }
}


/* ── Full-page split layout ── */
.auth-page {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: #0B0F1A;
}

/* ── Loading / already-authed screen ── */
.auth-loading-screen {
  min-height: 100vh;
  background: #0B0F1A;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  color: #94A3B8;
  font-family: 'Inter', sans-serif;
}
.auth-spinner {
  width: 36px;
  height: 36px;
  color: #00F5FF;
  animation: spin 1s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.auth-check-icon {
  width: 48px;
  height: 48px;
  color: #39FF14;
}
.auth-loading-screen h2 {
  font-family: 'Orbitron', sans-serif;
  font-size: 1.2rem;
  color: #E2E8F0;
}
.auth-already-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 24px;
  border-radius: 8px;
  background: linear-gradient(135deg, #00F5FF, #8B5CF6);
  color: #0B0F1A;
  font-weight: 700;
  text-decoration: none;
  margin-top: 0.5rem;
  transition: box-shadow 0.3s ease;
}
.auth-already-btn:hover {
  box-shadow: 0 0 20px rgba(0,245,255,0.4);
}

/* ══════ LEFT PANEL ══════ */
.auth-panel {
  position: relative;
  background: linear-gradient(160deg, #080C14 0%, #0D1020 100%);
  border-right: 1px solid rgba(0,245,255,0.1);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.auth-panel--purple {
  border-right: 1px solid rgba(139,92,246,0.15);
}

/* Radial glow */
.auth-panel-glow {
  position: absolute;
  top: -80px;
  left: -80px;
  width: 500px;
  height: 500px;
  background: radial-gradient(ellipse at center,
    rgba(0,245,255,0.09) 0%,
    rgba(139,92,246,0.06) 40%,
    transparent 70%);
  pointer-events: none;
}
.auth-panel-glow--purple {
  background: radial-gradient(ellipse at center,
    rgba(139,92,246,0.1) 0%,
    rgba(0,245,255,0.05) 40%,
    transparent 70%);
}

/* Grid overlay */
.auth-panel-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(0,245,255,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,245,255,0.03) 1px, transparent 1px);
  background-size: 50px 50px;
  pointer-events: none;
}

.auth-panel-content {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 2.5rem;
  gap: 0;
}

/* Logo */
.auth-panel-logo {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  margin-bottom: auto;
  width: fit-content;
}
.auth-panel-logo-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 8px;
  background: linear-gradient(135deg, rgba(0,245,255,0.14), rgba(139,92,246,0.14));
  border: 1px solid rgba(0,245,255,0.28);
}
.auth-panel-logo-text {
  font-family: 'Orbitron', sans-serif;
  font-size: 1rem;
  font-weight: 700;
  background: linear-gradient(90deg, #00F5FF, #8B5CF6);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: 0.06em;
}

/* Panel body */
.auth-panel-body {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  margin-top: 3rem;
  margin-bottom: auto;
}

.auth-panel-tag {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.72rem;
  font-weight: 700;
  color: #00F5FF;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 5px 14px;
  border-radius: 999px;
  border: 1px solid rgba(0,245,255,0.25);
  background: rgba(0,245,255,0.07);
  width: fit-content;
}
.auth-panel-tag--purple {
  color: #8B5CF6;
  border-color: rgba(139,92,246,0.25);
  background: rgba(139,92,246,0.07);
}

.auth-panel-heading {
  font-family: 'Orbitron', sans-serif;
  font-size: clamp(1.6rem, 3vw, 2.4rem);
  font-weight: 800;
  color: #F0F6FC;
  line-height: 1.2;
  letter-spacing: 0.02em;
}

.auth-panel-sub {
  color: #64748B;
  font-size: 0.88rem;
  line-height: 1.7;
  max-width: 320px;
}

/* Stats list */
.auth-panel-stats {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}
.auth-panel-stat {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 0.82rem;
  color: #94A3B8;
  font-weight: 500;
  padding: 8px 14px;
  border-radius: 8px;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.06);
  transition: background 0.2s ease, border-color 0.2s ease;
}
.auth-panel-stat:hover {
  background: rgba(255,255,255,0.05);
  border-color: rgba(255,255,255,0.1);
}

/* Footer note */
.auth-panel-footer-note {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.72rem;
  color: #334155;
  margin-top: 2.5rem;
}

/* ══════ RIGHT FORM SIDE ══════ */
.auth-form-side {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem 1.5rem;
  background: #0B0F1A;
  overflow-y: auto;
}

.auth-form-card {
  width: 100%;
  max-width: 420px;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

/* Header */
.auth-form-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 0.75rem;
}

.auth-form-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  border-radius: 14px;
  background: linear-gradient(135deg, rgba(0,245,255,0.12), rgba(139,92,246,0.12));
  border: 1px solid rgba(0,245,255,0.25);
  box-shadow: 0 0 20px rgba(0,245,255,0.1);
}
.auth-form-icon-wrap--purple {
  background: linear-gradient(135deg, rgba(139,92,246,0.14), rgba(0,245,255,0.08));
  border-color: rgba(139,92,246,0.3);
  box-shadow: 0 0 20px rgba(139,92,246,0.12);
}

.auth-form-title {
  font-family: 'Orbitron', sans-serif;
  font-size: 1.5rem;
  font-weight: 800;
  color: #F0F6FC;
  letter-spacing: 0.04em;
}

.auth-form-subtitle {
  color: #64748B;
  font-size: 0.85rem;
  line-height: 1.5;
}

/* Google button wrapper */
.auth-google-wrap {
  display: flex;
  justify-content: center;
}
.auth-google-wrap > div {
  width: 100% !important;
}

/* Divider */
.auth-divider {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}
.auth-divider-line {
  flex: 1;
  height: 1px;
  background: rgba(255,255,255,0.07);
}
.auth-divider-text {
  color: #475569;
  font-size: 0.75rem;
  white-space: nowrap;
  font-weight: 500;
}

/* Form fields */
.auth-form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.auth-field {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.auth-label {
  font-size: 0.78rem;
  font-weight: 600;
  color: #94A3B8;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.auth-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.auth-forgot-link {
  font-size: 0.75rem;
  color: #00F5FF;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  transition: text-shadow 0.2s ease;
}
.auth-forgot-link:hover {
  text-shadow: 0 0 8px rgba(0,245,255,0.5);
}

.auth-input-wrap {
  position: relative;
}

.auth-input {
  width: 100%;
  height: 46px;
  padding: 0 44px 0 14px;
  background: rgba(255,255,255,0.04) !important;
  border: 1px solid rgba(255,255,255,0.1) !important;
  border-radius: 10px;
  color: #F0F6FC !important;
  font-size: 0.9rem;
  font-family: 'Inter', sans-serif;
  transition: border-color 0.3s ease, box-shadow 0.3s ease, background 0.3s ease !important;
}
.auth-input::placeholder {
  color: #334155 !important;
  font-size: 0.82rem;
}
.auth-input:focus {
  outline: none;
  border-color: rgba(0,245,255,0.5) !important;
  background: rgba(0,245,255,0.03) !important;
  box-shadow: 0 0 0 3px rgba(0,245,255,0.1) !important;
}
.auth-input--purple:focus {
  border-color: rgba(139,92,246,0.5) !important;
  background: rgba(139,92,246,0.03) !important;
  box-shadow: 0 0 0 3px rgba(139,92,246,0.1) !important;
}
.auth-input--error {
  border-color: rgba(239,68,68,0.5) !important;
}
.auth-input--match {
  border-color: rgba(57,255,20,0.4) !important;
}

/* Input that doesn't have the eye btn needs different padding */
.auth-field > .auth-input {
  padding-right: 14px;
}

.auth-eye-btn {
  position: absolute;
  right: 13px;
  top: 50%;
  transform: translateY(-50%);
  color: #475569;
  background: none;
  border: none;
  cursor: pointer;
  padding: 2px;
  transition: color 0.2s ease;
  display: flex;
  align-items: center;
}
.auth-eye-btn:hover { color: #94A3B8; }

/* Password strength */
.auth-strength {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 4px;
}
.auth-strength-bars {
  display: flex;
  gap: 4px;
  flex: 1;
}
.auth-strength-bar {
  height: 3px;
  flex: 1;
  border-radius: 999px;
  transition: background 0.3s ease;
}
.auth-strength-label {
  font-size: 0.68rem;
  font-weight: 600;
  white-space: nowrap;
  transition: color 0.3s ease;
}

/* Match OK */
.auth-match-ok {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 0.72rem;
  color: #39FF14;
  font-weight: 500;
  margin-top: 2px;
}

/* Error / Success banners */
.auth-error {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 10px 14px;
  background: rgba(239,68,68,0.08);
  border: 1px solid rgba(239,68,68,0.25);
  border-radius: 8px;
  color: #FCA5A5;
  font-size: 0.82rem;
  line-height: 1.5;
}
.auth-success {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  background: rgba(57,255,20,0.07);
  border: 1px solid rgba(57,255,20,0.25);
  border-radius: 8px;
  color: #86EFAC;
  font-size: 0.82rem;
}

/* Submit button */
.auth-submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  height: 48px;
  border-radius: 10px;
  background: linear-gradient(135deg, #00F5FF, #8B5CF6);
  color: #0B0F1A;
  font-weight: 700;
  font-size: 0.95rem;
  border: none;
  cursor: pointer;
  transition: box-shadow 0.3s ease, transform 0.2s ease, opacity 0.2s ease;
  margin-top: 0.5rem;
  font-family: 'Inter', sans-serif;
}
.auth-submit-btn:hover:not(:disabled) {
  box-shadow: 0 0 28px rgba(0,245,255,0.35), 0 6px 18px rgba(0,0,0,0.3);
  transform: translateY(-1px);
}
.auth-submit-btn:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}
.auth-submit-btn--purple {
  background: linear-gradient(135deg, #8B5CF6, #00F5FF);
}
.auth-submit-btn--purple:hover:not(:disabled) {
  box-shadow: 0 0 28px rgba(139,92,246,0.35), 0 6px 18px rgba(0,0,0,0.3);
}

/* Spinner inside button */
.auth-spin {
  animation: spin 1s linear infinite;
}

/* Terms */
.auth-terms {
  font-size: 0.72rem;
  color: #475569;
  text-align: center;
  line-height: 1.6;
}
.auth-terms-link {
  color: #8B5CF6;
  text-decoration: none;
  transition: text-shadow 0.2s ease;
}
.auth-terms-link:hover {
  text-shadow: 0 0 8px rgba(139,92,246,0.5);
}

/* Switch link */
.auth-switch {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  font-size: 0.82rem;
  color: #475569;
}
.auth-switch-link {
  color: #00F5FF;
  font-weight: 600;
  text-decoration: none;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  font-size: 0.82rem;
  transition: text-shadow 0.2s ease;
}
.auth-switch-link:hover {
  text-shadow: 0 0 8px rgba(0,245,255,0.5);
}

/* ── AUTH RESPONSIVE ── */
@media (max-width: 900px) {
  .auth-page {
    grid-template-columns: 1fr;
  }
  .auth-panel {
    display: none;
  }
  .auth-form-side {
    min-height: 100vh;
    padding: 2rem 1.25rem;
    /* Add subtle background when panel is hidden */
    background: #0B0F1A;
    position: relative;
  }
  .auth-form-side::before {
    content: '';
    position: absolute;
    top: -100px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(ellipse at center,
      rgba(0,245,255,0.06) 0%,
      rgba(139,92,246,0.04) 40%,
      transparent 70%);
    pointer-events: none;
  }
  .auth-page--register .auth-form-side::before {
    background: radial-gradient(ellipse at center,
      rgba(139,92,246,0.07) 0%,
      rgba(0,245,255,0.04) 40%,
      transparent 70%);
  }
}

@media (max-width: 480px) {
  .auth-form-card {
    gap: 1.25rem;
  }
  .auth-form-title {
    font-size: 1.25rem;
  }
  .auth-input {
    height: 42px;
  }
  .auth-submit-btn {
    height: 44px;
  }
}

/* ==========================================
   FORGOT PASSWORD — SPECIFIC STYLES
   ========================================== */

/* Gold logo icon override */
.fp-logo-icon {
  background: linear-gradient(135deg, rgba(250,204,21,0.14), rgba(139,92,246,0.1)) !important;
  border-color: rgba(250,204,21,0.3) !important;
}

/* Card max-width override */
.fp-card {
  max-width: 460px;
}

/* Centered key icon */
.fp-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  border-radius: 14px;
  background: linear-gradient(135deg, rgba(250,204,21,0.12), rgba(139,92,246,0.1));
  border: 1px solid rgba(250,204,21,0.28);
  box-shadow: 0 0 20px rgba(250,204,21,0.1);
  margin: 0 auto 0.25rem;
}

/* Step indicator */
.fp-steps {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  position: relative;
  padding: 0.25rem 0;
}

.fp-step-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  font-size: 0.72rem;
  font-weight: 700;
  font-family: 'Orbitron', sans-serif;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  color: #475569;
  z-index: 1;
  flex-shrink: 0;
  transition: background 0.3s ease, border-color 0.3s ease, color 0.3s ease;
}
.fp-step-dot--active {
  background: rgba(250,204,21,0.12);
  border-color: rgba(250,204,21,0.45);
  color: #FACC15;
  box-shadow: 0 0 12px rgba(250,204,21,0.2);
}
.fp-step-dot--done {
  background: rgba(57,255,20,0.1);
  border-color: rgba(57,255,20,0.35);
  color: #39FF14;
}

.fp-step-line {
  width: 60px;
  height: 1px;
  background: rgba(255,255,255,0.08);
  flex-shrink: 0;
  transition: background 0.4s ease;
}
.fp-step-line--done {
  background: rgba(57,255,20,0.3);
}

/* Mail icon inside input */
.fp-field-icon {
  position: absolute;
  right: 13px;
  top: 50%;
  transform: translateY(-50%);
  color: #334155;
  pointer-events: none;
}

/* Hint text */
.fp-hint {
  font-size: 0.7rem;
  color: #334155;
  line-height: 1.5;
  margin-top: 3px;
}

/* OTP / 2FA input */
.fp-otp-input {
  text-align: center !important;
  font-size: 1.5rem !important;
  letter-spacing: 0.35em !important;
  font-family: 'Orbitron', sans-serif !important;
  padding-right: 13px !important;
}

/* Gold-accented submit button */
.fp-submit {
  background: linear-gradient(135deg, #FACC15, #F97316) !important;
  color: #080C14 !important;
}
.fp-submit:hover:not(:disabled) {
  box-shadow: 0 0 28px rgba(250,204,21,0.3), 0 6px 20px rgba(0,0,0,0.35) !important;
}

/* Back to step 1 button */
.fp-back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  font-size: 0.8rem;
  color: #475569;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  transition: color 0.2s ease;
  font-family: 'Inter', sans-serif;
}
.fp-back-btn:hover { color: #94A3B8; }

/* Back to login link */
.fp-back-login {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  font-size: 0.8rem;
  color: #00F5FF;
  text-decoration: none;
  font-weight: 500;
  transition: text-shadow 0.2s ease;
  margin-top: -0.25rem;
}
.fp-back-login:hover {
  text-shadow: 0 0 8px rgba(0,245,255,0.4);
}


/* ==========================================
   DASHBOARD — CYBERPUNK COMMAND CENTER
   ========================================== */

.db-root {
  min-height: 100vh;
  background: #0B0F1A;
  position: relative;
  overflow-x: hidden;
  padding-bottom: 3rem;
}
.db-bg-glow {
  position: fixed;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(100px);
  z-index: 0;
}
.db-bg-glow--top {
  top: -200px; left: 50%; transform: translateX(-50%);
  width: 900px; height: 600px;
  background: radial-gradient(ellipse, rgba(0,245,255,0.06) 0%, rgba(139,92,246,0.04) 50%, transparent 70%);
}
.db-bg-glow--right {
  top: 40%; right: -200px;
  width: 500px; height: 500px;
  background: radial-gradient(ellipse, rgba(139,92,246,0.07) 0%, transparent 65%);
}
.db-grid-overlay {
  position: fixed; inset: 0;
  background-image:
    linear-gradient(rgba(0,245,255,0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,245,255,0.025) 1px, transparent 1px);
  background-size: 60px 60px;
  pointer-events: none; z-index: 0;
  mask-image: radial-gradient(ellipse at 50% 30%, black 0%, transparent 80%);
  -webkit-mask-image: radial-gradient(ellipse at 50% 30%, black 0%, transparent 80%);
}
.db-container {
  position: relative; z-index: 1;
  max-width: 1400px; margin: 0 auto;
  padding: 2rem 1.5rem;
  display: flex; flex-direction: column; gap: 1.5rem;
}

/* HEADER */
.db-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
.db-header-left { display: flex; flex-direction: column; gap: 0.75rem; flex: 1; }
.db-header-greeting { font-size: 0.85rem; color: #475569; font-weight: 500; margin: 0; }
.db-header-name { font-family: 'Orbitron', sans-serif; font-size: clamp(1.6rem, 3vw, 2.4rem); font-weight: 800; color: #F0F6FC; letter-spacing: 0.02em; margin: 0; line-height: 1.1; }
.db-header-name-accent {
  background: linear-gradient(90deg, #00F5FF, #8B5CF6, #39FF14);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  background-size: 200%; animation: db-gradient-shift 4s linear infinite;
}
@keyframes db-gradient-shift { 0% { background-position: 0%; } 100% { background-position: 200%; } }
.db-header-badges { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
.db-badge { display: inline-flex; align-items: center; gap: 5px; font-size: 0.7rem; font-weight: 700; padding: 4px 11px; border-radius: 999px; letter-spacing: 0.04em; }
.db-badge--premium  { color: #FACC15; background: rgba(250,204,21,0.1);   border: 1px solid rgba(250,204,21,0.3);  }
.db-badge--level    { color: #8B5CF6; background: rgba(139,92,246,0.1);   border: 1px solid rgba(139,92,246,0.3);  }
.db-badge--rank     { color: #00F5FF; background: rgba(0,245,255,0.08);   border: 1px solid rgba(0,245,255,0.25); }
.db-header-actions  { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; padding-top: 0.25rem; }

/* Action buttons */
.db-action-btn { display: inline-flex; align-items: center; gap: 7px; padding: 9px 18px; border-radius: 10px; font-size: 0.82rem; font-weight: 700; text-decoration: none; transition: box-shadow 0.3s ease, transform 0.2s ease; font-family: 'Inter', sans-serif; border: none; cursor: pointer; white-space: nowrap; }
.db-action-btn--cyan  { background: linear-gradient(135deg, #00F5FF, #0891B2); color: #0B0F1A; }
.db-action-btn--cyan:hover   { box-shadow: 0 0 20px rgba(0,245,255,0.35); transform: translateY(-1px); }
.db-action-btn--purple { background: linear-gradient(135deg, #8B5CF6, #6D28D9); color: #fff; }
.db-action-btn--purple:hover { box-shadow: 0 0 20px rgba(139,92,246,0.35); transform: translateY(-1px); }
.db-action-btn--ghost { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #94A3B8; }
.db-action-btn--ghost:hover  { background: rgba(255,255,255,0.08); color: #E2E8F0; }

/* XP Bar */
.db-xp-bar-wrap { display: flex; flex-direction: column; gap: 4px; max-width: 480px; }
.db-xp-bar-labels { display: flex; justify-content: space-between; align-items: center; }
.db-xp-label { display: flex; align-items: center; gap: 4px; font-size: 0.72rem; color: #64748B; font-weight: 600; }
.db-xp-label--right { color: #FACC15; }
.db-xp-track { height: 6px; background: rgba(255,255,255,0.07); border-radius: 999px; overflow: hidden; }
.db-xp-fill { height: 100%; background: linear-gradient(90deg, #FACC15, #F97316); border-radius: 999px; box-shadow: 0 0 8px rgba(250,204,21,0.4); transition: width 1.2s ease; }
.db-xp-hint { font-size: 0.65rem; color: #334155; margin: 0; }

/* Stats Strip */
.db-stats-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
.db-stat-card { display: flex; align-items: center; gap: 0.85rem; padding: 1rem 1.25rem; background: rgba(17,24,39,0.7); border: 1px solid rgba(255,255,255,0.07); border-radius: 14px; backdrop-filter: blur(12px); box-shadow: 0 4px 20px rgba(0,0,0,0.25); transition: border-color 0.25s ease, transform 0.2s ease; }
.db-stat-card:hover { transform: translateY(-3px); border-color: rgba(255,255,255,0.12); }
.db-stat-icon-wrap { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 10px; flex-shrink: 0; }
.db-stat-val { font-family: 'Orbitron', sans-serif; font-size: 1.3rem; font-weight: 800; line-height: 1; }
.db-stat-label { font-size: 0.72rem; color: #475569; font-weight: 500; margin-top: 3px; }

/* 2-col layout */
.db-cols { display: grid; grid-template-columns: 1fr 360px; gap: 1.25rem; align-items: start; }
.db-left  { display: flex; flex-direction: column; gap: 1.25rem; }
.db-right { display: flex; flex-direction: column; gap: 1.25rem; }

/* Card */
.db-card { background: rgba(15,20,35,0.72); border: 1px solid rgba(255,255,255,0.07); border-radius: 16px; padding: 1.5rem; backdrop-filter: blur(16px); box-shadow: 0 8px 32px rgba(0,0,0,0.3); transition: border-color 0.25s ease; }
.db-card:hover { border-color: rgba(255,255,255,0.1); }
.db-card--tabs { padding: 0; }
.db-card--streak { border-color: rgba(255,107,53,0.15); background: linear-gradient(135deg, rgba(255,107,53,0.05) 0%, rgba(15,20,35,0.8) 60%); text-align: center; }
.db-card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
.db-section-title { display: flex; align-items: center; gap: 7px; font-size: 0.92rem; font-weight: 700; color: #E2E8F0; font-family: 'Orbitron', sans-serif; letter-spacing: 0.04em; margin: 0; }
.db-viewall-link { display: flex; align-items: center; gap: 3px; font-size: 0.75rem; color: #00F5FF; text-decoration: none; font-weight: 600; transition: text-shadow 0.2s ease; }
.db-viewall-link:hover { text-shadow: 0 0 8px rgba(0,245,255,0.5); }

/* Tabs */
.db-tab-bar { display: flex; align-items: center; gap: 4px; padding: 0.75rem 1rem; border-bottom: 1px solid rgba(255,255,255,0.07); overflow-x: auto; }
.db-tab { display: flex; align-items: center; gap: 6px; padding: 7px 14px; border-radius: 8px; font-size: 0.8rem; font-weight: 600; color: #475569; background: none; border: 1px solid transparent; cursor: pointer; transition: all 0.2s ease; white-space: nowrap; font-family: 'Inter', sans-serif; }
.db-tab:hover { color: #94A3B8; background: rgba(255,255,255,0.04); }
.db-tab--active { color: #00F5FF; background: rgba(0,245,255,0.08); border-color: rgba(0,245,255,0.22); }
.db-tab-viewall { display: flex; align-items: center; gap: 4px; font-size: 0.75rem; color: #00F5FF; text-decoration: none; font-weight: 600; margin-left: auto; }
.db-tab-content { padding: 1.25rem; display: flex; flex-direction: column; gap: 1rem; }

/* Mission Card */
.db-mission-card { border: 1px solid rgba(0,245,255,0.12); border-radius: 12px; background: rgba(0,245,255,0.03); overflow: hidden; transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease; }
.db-mission-card:hover { transform: translateY(-4px); border-color: rgba(0,245,255,0.28); box-shadow: 0 8px 24px rgba(0,0,0,0.35), 0 0 20px rgba(0,245,255,0.06); }
.db-mission-card--done { border-color: rgba(57,255,20,0.12); background: rgba(57,255,20,0.02); }
.db-mission-card--done:hover { border-color: rgba(57,255,20,0.28); box-shadow: 0 8px 24px rgba(0,0,0,0.35), 0 0 20px rgba(57,255,20,0.06); }
.db-mission-card-tag { padding: 5px 14px; background: linear-gradient(90deg, rgba(0,245,255,0.12), transparent); border-bottom: 1px solid rgba(0,245,255,0.1); font-size: 0.65rem; font-weight: 700; color: #00F5FF; letter-spacing: 0.1em; text-transform: uppercase; }
.db-mission-card-body { padding: 1rem; display: flex; flex-direction: column; gap: 0.75rem; }
.db-mission-card-info { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
.db-mission-card-title { font-size: 0.95rem; font-weight: 700; color: #E2E8F0; margin: 0; }
.db-mission-card-footer { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }

/* Difficulty badge */
.db-difficulty-badge { display: inline-flex; align-items: center; padding: 3px 9px; border-radius: 6px; font-size: 0.68rem; font-weight: 700; white-space: nowrap; }

/* Progress bar */
.db-progress-wrap { display: flex; flex-direction: column; gap: 4px; }
.db-progress-labels { display: flex; justify-content: space-between; font-size: 0.72rem; color: #475569; }
.db-progress-track { height: 6px; background: rgba(255,255,255,0.07); border-radius: 999px; overflow: hidden; }
.db-progress-fill { height: 100%; border-radius: 999px; transition: width 1s ease; }
.db-progress-fill--cyan  { background: linear-gradient(90deg, #00F5FF, #0891B2); box-shadow: 0 0 8px rgba(0,245,255,0.4); }
.db-progress-fill--green { background: linear-gradient(90deg, #39FF14, #22C55E); box-shadow: 0 0 8px rgba(57,255,20,0.35); }

/* Buttons */
.db-resume-btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 8px; background: linear-gradient(135deg, #00F5FF, #0891B2); color: #0B0F1A; font-weight: 700; font-size: 0.8rem; text-decoration: none; transition: box-shadow 0.3s ease, transform 0.2s ease; font-family: 'Inter', sans-serif; }
.db-resume-btn:hover { box-shadow: 0 0 16px rgba(0,245,255,0.35); transform: scale(1.03); }
.db-xp-reward { display: flex; align-items: center; gap: 5px; font-size: 0.8rem; color: #FACC15; font-weight: 700; }
.db-done-badge { display: flex; align-items: center; gap: 5px; font-size: 0.78rem; color: #39FF14; font-weight: 600; }
.db-ghost-btn { display: inline-flex; align-items: center; gap: 5px; padding: 6px 12px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1); color: #94A3B8; font-size: 0.78rem; font-weight: 600; text-decoration: none; background: none; transition: border-color 0.2s ease, color 0.2s ease; font-family: 'Inter', sans-serif; cursor: pointer; }
.db-ghost-btn:hover { border-color: rgba(255,255,255,0.2); color: #E2E8F0; }
.db-mini-btn { display: inline-flex; padding: 5px 12px; border-radius: 7px; background: linear-gradient(135deg, #00F5FF, #8B5CF6); color: #0B0F1A; font-size: 0.75rem; font-weight: 700; text-decoration: none; transition: box-shadow 0.2s ease; font-family: 'Inter', sans-serif; cursor: pointer; border: none; }
.db-mini-btn:hover { box-shadow: 0 0 12px rgba(0,245,255,0.3); }

/* List items */
.db-list-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem; border: 1px solid rgba(255,255,255,0.06); border-radius: 10px; background: rgba(255,255,255,0.02); transition: border-color 0.2s ease, background 0.2s ease; }
.db-list-item:hover { border-color: rgba(255,255,255,0.1); background: rgba(255,255,255,0.04); }
.db-list-item-icon { font-size: 1.4rem; flex-shrink: 0; }
.db-list-item-info { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 0; }
.db-list-item-title { font-size: 0.85rem; font-weight: 600; color: #E2E8F0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.db-list-item-sub { font-size: 0.7rem; color: #475569; }

/* New Rooms Grid */
.db-new-rooms-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.85rem; }
.db-new-room-card { display: flex; flex-direction: column; gap: 0.5rem; padding: 1rem; border: 1px solid rgba(255,255,255,0.07); border-radius: 12px; background: rgba(255,255,255,0.02); text-decoration: none; transition: transform 0.2s ease, border-color 0.25s ease, box-shadow 0.25s ease; }
.db-new-room-card:hover { transform: translateY(-3px); border-color: rgba(0,245,255,0.2); box-shadow: 0 6px 20px rgba(0,0,0,0.3); }
.db-new-room-top { display: flex; align-items: center; justify-content: space-between; }
.db-new-room-icon { font-size: 1.5rem; }
.db-new-room-title { font-size: 0.82rem; font-weight: 700; color: #E2E8F0; line-height: 1.3; }
.db-new-room-meta { display: flex; align-items: center; gap: 0.5rem; }

/* Weekly */
.db-weekly-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.85rem; }
.db-weekly-item { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 0.85rem; border: 1px solid rgba(255,255,255,0.06); border-radius: 10px; background: rgba(255,255,255,0.02); }
.db-weekly-val { font-family: 'Orbitron', sans-serif; font-size: 1.1rem; font-weight: 800; }
.db-weekly-label { font-size: 0.68rem; color: #475569; font-weight: 500; }

/* Streak Ring */
.db-streak-ring-wrap { display: flex; justify-content: center; margin: 0.5rem 0; }
.db-streak-svg { overflow: visible; }
.db-streak-best { font-size: 0.8rem; color: #475569; margin: 0; }
.db-streak-active-badge { font-size: 0.65rem; padding: 3px 8px; border-radius: 999px; background: rgba(255,107,53,0.12); border: 1px solid rgba(255,107,53,0.28); color: #FF6B35; font-weight: 700; }
.db-streak-hint { font-size: 0.72rem; color: #475569; line-height: 1.5; padding: 8px 12px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 8px; margin-top: 0.5rem; }

/* Skills */
.db-skills-list { display: flex; flex-direction: column; gap: 0.75rem; }
.db-skill-row { display: flex; align-items: center; gap: 0.6rem; }
.db-skill-icon-wrap { display: flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 6px; flex-shrink: 0; }
.db-skill-info { display: flex; align-items: center; gap: 0.5rem; width: 140px; flex-shrink: 0; }
.db-skill-name { font-size: 0.75rem; color: #94A3B8; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1; }
.db-skill-track { flex: 1; height: 5px; background: rgba(255,255,255,0.06); border-radius: 999px; overflow: hidden; }
.db-skill-fill { height: 100%; border-radius: 999px; transition: width 1.2s ease; }
.db-skill-pct { font-size: 0.7rem; font-weight: 700; width: 32px; text-align: right; flex-shrink: 0; }
.db-skills-note { font-size: 0.68rem; color: #334155; margin: 0.25rem 0 0; }

/* Missions */
.db-missions-list { display: flex; flex-direction: column; gap: 0.6rem; }
.db-mission { padding: 0.75rem; border: 1px solid rgba(255,255,255,0.07); border-radius: 9px; background: rgba(255,255,255,0.02); display: flex; flex-direction: column; gap: 5px; }
.db-mission--done { border-color: rgba(57,255,20,0.18); background: rgba(57,255,20,0.03); }
.db-mission-head { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
.db-mission-title { font-size: 0.78rem; font-weight: 600; color: #94A3B8; }
.db-mission-track { height: 4px; background: rgba(255,255,255,0.06); border-radius: 999px; overflow: hidden; }
.db-mission-fill { height: 100%; background: linear-gradient(90deg, #00F5FF, #8B5CF6); border-radius: 999px; transition: width 1s ease; }
.db-mission-count { font-size: 0.65rem; color: #475569; font-weight: 600; align-self: flex-end; }

/* Leaderboard */
.db-leaders-list { display: flex; flex-direction: column; gap: 0.5rem; }
.db-leader-row { display: flex; align-items: center; gap: 0.6rem; padding: 0.65rem 0.75rem; border-radius: 9px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06); transition: background 0.2s ease; }
.db-leader-row:hover { background: rgba(255,255,255,0.04); }
.db-leader-row--gold { background: rgba(250,204,21,0.06); border-color: rgba(250,204,21,0.2); box-shadow: 0 0 12px rgba(250,204,21,0.07); }
.db-leader-row--me { border-color: rgba(0,245,255,0.2); background: rgba(0,245,255,0.04); }
.db-leader-rank { display: flex; align-items: center; justify-content: center; min-width: 28px; font-size: 0.7rem; font-weight: 800; font-family: 'Orbitron', sans-serif; color: #475569; }
.db-leader-rank--gold { color: #FACC15; }
.db-leader-info { display: flex; flex-direction: column; flex: 1; min-width: 0; }
.db-leader-name { font-size: 0.8rem; font-weight: 600; color: #E2E8F0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.db-leader-level { font-size: 0.65rem; color: #475569; }
.db-leader-pts { font-size: 0.78rem; font-weight: 700; color: #FACC15; white-space: nowrap; }
.db-leaders-empty { font-size: 0.78rem; color: #334155; text-align: center; padding: 1rem 0; }

/* Empty state */
.db-empty-state { display: flex; flex-direction: column; align-items: center; gap: 0.75rem; padding: 2.5rem 1rem; text-align: center; }
.db-empty-state--sm { padding: 1.5rem 1rem; }
.db-empty-state h3 { font-size: 1rem; font-weight: 700; color: #E2E8F0; margin: 0; }
.db-empty-state p  { font-size: 0.82rem; color: #475569; margin: 0; }

/* Responsive */
@media (max-width: 1100px) {
  .db-cols { grid-template-columns: 1fr; }
  .db-right { order: -1; display: grid; grid-template-columns: repeat(2, 1fr); }
  .db-stats-strip { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 700px) {
  .db-container { padding: 1rem; }
  .db-right { grid-template-columns: 1fr; }
  .db-header { flex-direction: column; }
  .db-header-actions { width: 100%; }
  .db-new-rooms-grid { grid-template-columns: 1fr; }
  .db-skill-info { width: 110px; }
}
@media (max-width: 400px) {
  .db-stats-strip { grid-template-columns: 1fr 1fr; }
}


/* ==========================================
   LABS / HACKTIVITIES PAGE
   ========================================== */

/* Root */
.lp-root {
  min-height: 100vh;
  background: #0B0F1A;
  position: relative;
  overflow-x: hidden;
  padding-bottom: 3rem;
}
.lp-bg-glow {
  position: fixed; border-radius: 50%; pointer-events: none; filter: blur(120px); z-index: 0;
}
.lp-bg-glow--tl {
  top: -150px; left: -100px; width: 600px; height: 500px;
  background: radial-gradient(ellipse, rgba(0,245,255,0.05) 0%, transparent 70%);
}
.lp-bg-glow--br {
  bottom: -100px; right: -100px; width: 500px; height: 400px;
  background: radial-gradient(ellipse, rgba(139,92,246,0.06) 0%, transparent 70%);
}
.lp-grid-overlay {
  position: fixed; inset: 0;
  background-image: linear-gradient(rgba(0,245,255,0.02) 1px,transparent 1px),
                    linear-gradient(90deg, rgba(0,245,255,0.02) 1px, transparent 1px);
  background-size: 55px 55px;
  pointer-events: none; z-index: 0;
  mask-image: radial-gradient(ellipse at 50% 20%, black 0%, transparent 75%);
  -webkit-mask-image: radial-gradient(ellipse at 50% 20%, black 0%, transparent 75%);
}
.lp-container {
  position: relative; z-index: 1;
  max-width: 1480px; margin: 0 auto;
  padding: 2rem 1.5rem;
  display: flex; flex-direction: column; gap: 1.75rem;
}

/* PAGE HEADER */
.lp-page-header {
  display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
}
.lp-page-title {
  display: flex; align-items: center; gap: 12px;
  font-family: 'Orbitron', sans-serif; font-size: clamp(1.6rem, 3vw, 2.2rem);
  font-weight: 800; color: #E2E8F0; letter-spacing: 0.02em; margin: 0;
}
.lp-title-accent {
  background: linear-gradient(90deg, #00F5FF, #8B5CF6);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.lp-page-sub { font-size: 0.88rem; color: #475569; margin: 0.35rem 0 0; }
.lp-mobile-filter-btn {
  display: none; align-items: center; gap: 7px; padding: 9px 16px; border-radius: 10px;
  background: rgba(0,245,255,0.08); border: 1px solid rgba(0,245,255,0.2); color: #00F5FF;
  font-size: 0.82rem; font-weight: 700; font-family: 'Inter', sans-serif; cursor: pointer;
  position: relative;
}
.lp-filter-count {
  display: inline-flex; align-items: center; justify-content: center;
  width: 18px; height: 18px; border-radius: 50%; font-size: 0.6rem; font-weight: 800;
  background: #00F5FF; color: #0B0F1A;
}

/* HORIZONTAL STRIPS */
.lp-strips { display: flex; flex-direction: column; gap: 1.5rem; }
.lp-hstrip { }
.lp-hstrip-header {
  display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem;
}
.lp-hstrip-title {
  display: flex; align-items: center; gap: 8px;
  font-family: 'Orbitron', sans-serif; font-size: 0.9rem; font-weight: 700; letter-spacing: 0.04em; margin: 0;
}
.lp-hstrip-nav { display: flex; gap: 6px; }
.lp-scroll-btn {
  display: flex; align-items: center; justify-content: center;
  width: 28px; height: 28px; border-radius: 7px;
  background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08);
  color: #94A3B8; cursor: pointer; transition: background 0.2s ease;
}
.lp-scroll-btn:hover { background: rgba(255,255,255,0.1); color: #E2E8F0; }
.lp-hstrip-track {
  display: flex; gap: 1rem;
  overflow-x: auto; padding-bottom: 8px;
  scrollbar-width: thin; scrollbar-color: rgba(0,245,255,0.2) transparent;
  scroll-snap-type: x mandatory;
}
.lp-hstrip-track::-webkit-scrollbar { height: 4px; }
.lp-hstrip-track::-webkit-scrollbar-thumb { background: rgba(0,245,255,0.2); border-radius: 99px; }
.lp-hstrip-item {
  flex-shrink: 0; width: 260px; scroll-snap-align: start;
}

/* MAIN LAYOUT */
.lp-main-layout {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 1.5rem;
  align-items: start;
}
.lp-sidebar-wrap { }

/* SIDEBAR */
.lp-sidebar {
  background: rgba(15,20,35,0.75);
  border: 1px solid rgba(0,245,255,0.1);
  border-radius: 16px;
  padding: 1.25rem;
  backdrop-filter: blur(18px);
  box-shadow: 0 8px 32px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.04);
  position: sticky; top: 80px;
  max-height: calc(100vh - 100px);
  overflow-y: auto;
  scrollbar-width: thin; scrollbar-color: rgba(0,245,255,0.15) transparent;
  display: flex; flex-direction: column; gap: 0.25rem;
}
.lp-sidebar::-webkit-scrollbar { width: 4px; }
.lp-sidebar::-webkit-scrollbar-thumb { background: rgba(0,245,255,0.15); border-radius: 99px; }
.lp-sidebar-head {
  display: flex; align-items: center; justify-content: space-between;
  padding-bottom: 0.85rem; border-bottom: 1px solid rgba(255,255,255,0.06); margin-bottom: 0.75rem;
}
.lp-sidebar-title {
  display: flex; align-items: center; gap: 7px;
  font-size: 0.82rem; font-weight: 700; color: #E2E8F0; font-family: 'Orbitron', sans-serif; letter-spacing: 0.06em;
}
.lp-sidebar-clear {
  font-size: 0.72rem; color: #475569; background: none; border: none; cursor: pointer;
  transition: color 0.2s ease; font-family: 'Inter', sans-serif;
}
.lp-sidebar-clear:hover { color: #00F5FF; }

/* Filter search */
.lp-filter-search-wrap {
  position: relative; margin-bottom: 0.5rem;
}
.lp-filter-search-icon {
  position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: #334155;
}
.lp-filter-search {
  width: 100%; padding: 8px 12px 8px 30px; border-radius: 8px;
  background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.07);
  color: #E2E8F0; font-size: 0.8rem; font-family: 'Inter', sans-serif; outline: none;
  box-sizing: border-box;
  transition: border-color 0.2s ease;
}
.lp-filter-search:focus { border-color: rgba(0,245,255,0.3); box-shadow: 0 0 0 2px rgba(0,245,255,0.08); }
.lp-filter-search::placeholder { color: #334155; }

/* Filter sections */
.lp-filter-section { border-bottom: 1px solid rgba(255,255,255,0.05); padding: 0.6rem 0; }
.lp-filter-section:last-child { border-bottom: none; }
.lp-filter-section-head {
  display: flex; align-items: center; justify-content: space-between;
  width: 100%; font-size: 0.76rem; font-weight: 700; color: #64748B;
  background: none; border: none; cursor: pointer; padding: 0 0 0.4rem;
  font-family: 'Inter', sans-serif; letter-spacing: 0.05em; text-transform: uppercase;
}
.lp-filter-section-body { display: flex; flex-direction: column; gap: 4px; padding-top: 0.25rem; }
.lp-filter-radio, .lp-filter-check {
  display: flex; align-items: center; gap: 8px; cursor: pointer;
  padding: 5px 6px; border-radius: 7px; transition: background 0.15s ease;
}
.lp-filter-radio:hover, .lp-filter-check:hover { background: rgba(255,255,255,0.04); }
.lp-filter-radio input, .lp-filter-check input { accent-color: #00F5FF; cursor: pointer; }
.lp-filter-radio span, .lp-filter-check span { font-size: 0.8rem; color: #94A3B8; }
.lp-filter-tags { display: flex; flex-wrap: wrap; gap: 5px; }
.lp-filter-tag {
  padding: 3px 9px; border-radius: 6px; font-size: 0.7rem; font-weight: 600; cursor: pointer;
  background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); color: #64748B;
  transition: all 0.2s ease;
}
.lp-filter-tag--active {
  background: rgba(0,245,255,0.1); border-color: rgba(0,245,255,0.3); color: #00F5FF;
}

/* TOOLBAR */
.lp-toolbar {
  display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem;
  margin-bottom: 1.25rem;
}
.lp-count { font-size: 0.82rem; color: #475569; }
.lp-active-filters { color: #8B5CF6; }
.lp-toolbar-right { display: flex; align-items: center; gap: 0.75rem; }
.lp-sort-wrap { position: relative; display: flex; align-items: center; }
.lp-sort-icon { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); color: #475569; pointer-events: none; }
.lp-sort-select {
  padding: 8px 32px 8px 12px; border-radius: 9px; font-size: 0.8rem; font-weight: 600;
  background: rgba(17,24,39,0.8); border: 1px solid rgba(255,255,255,0.08); color: #94A3B8;
  appearance: none; cursor: pointer; outline: none; font-family: 'Inter', sans-serif;
  transition: border-color 0.2s ease;
}
.lp-sort-select:focus { border-color: rgba(0,245,255,0.25); }
.lp-view-toggle { display: flex; background: rgba(17,24,39,0.8); border: 1px solid rgba(255,255,255,0.07); border-radius: 9px; overflow: hidden; }
.lp-view-btn { display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; color: #475569; background: none; border: none; cursor: pointer; transition: all 0.2s ease; }
.lp-view-btn--active { background: rgba(0,245,255,0.12); color: #00F5FF; }
.lp-view-btn:hover:not(.lp-view-btn--active) { color: #94A3B8; }

/* GRID */
.lp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.1rem; }
.lp-grid--list { grid-template-columns: 1fr; }

/* LAB CARD */
.lp-card {
  background: rgba(15,20,35,0.75);
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: 14px; overflow: hidden;
  backdrop-filter: blur(12px);
  box-shadow: 0 6px 24px rgba(0,0,0,0.28);
  transition: transform 0.28s ease, border-color 0.28s ease, box-shadow 0.28s ease;
  display: flex; flex-direction: column;
}
.lp-card:hover {
  transform: translateY(-6px);
  border-color: rgba(0,245,255,0.2);
  box-shadow: 0 16px 40px rgba(0,0,0,0.4), 0 0 20px rgba(0,245,255,0.06);
}
.lp-card--done {
  border-color: rgba(57,255,20,0.15);
}
.lp-card--done:hover {
  border-color: rgba(57,255,20,0.3);
  box-shadow: 0 16px 40px rgba(0,0,0,0.4), 0 0 20px rgba(57,255,20,0.06);
}
.lp-card--locked { opacity: 0.9; }

/* Thumbnail */
.lp-card-thumb { position: relative; overflow: hidden; height: 160px; background: #0B0F1A; }
.lp-card-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; display: block; }
.lp-card:hover .lp-card-img { transform: scale(1.06); }
.lp-card-badges-top { position: absolute; top: 10px; right: 10px; display: flex; gap: 6px; flex-wrap: wrap; }
.lp-card-badges-bot { position: absolute; bottom: 10px; left: 10px; }
.lp-badge {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 3px 8px; border-radius: 6px; font-size: 0.65rem; font-weight: 800; letter-spacing: 0.05em;
  backdrop-filter: blur(8px);
}
.lp-badge--pro   { background: rgba(250,204,21,0.85); color: #0B0F1A; }
.lp-badge--free  { background: rgba(57,255,20,0.85); color: #0B0F1A; }
.lp-badge--done  { background: rgba(57,255,20,0.9); color: #0B0F1A; }
.lp-type-badge {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 4px 9px; border-radius: 6px; font-size: 0.68rem; font-weight: 700;
  backdrop-filter: blur(8px);
}
.lp-type-badge--ctf  { background: rgba(139,92,246,0.85); color: #fff; }
.lp-type-badge--walk { background: rgba(30,80,200,0.85); color: #fff; }

/* Lock overlay */
.lp-lock-overlay {
  position: absolute; inset: 0;
  background: rgba(11,15,26,0.82); backdrop-filter: blur(6px);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 8px; color: #64748B; font-size: 0.75rem; font-weight: 600;
}
.lp-upgrade-btn {
  padding: 5px 14px; border-radius: 7px;
  background: linear-gradient(135deg, #FACC15, #F97316); color: #0B0F1A;
  font-size: 0.75rem; font-weight: 800; text-decoration: none;
  transition: box-shadow 0.2s ease;
}
.lp-upgrade-btn:hover { box-shadow: 0 0 12px rgba(250,204,21,0.4); }

/* Card body */
.lp-card-body { padding: 1rem; display: flex; flex-direction: column; gap: 0.5rem; flex: 1; }
.lp-card-title {
  font-size: 0.9rem; font-weight: 700; color: #E2E8F0; line-height: 1.3;
  display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  transition: color 0.2s ease;
}
.lp-card:hover .lp-card-title { color: #00F5FF; }
.lp-card-creator { font-size: 0.7rem; color: #475569; }
.lp-card-meta-row { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
.lp-stars { display: flex; align-items: center; gap: 2px; }
.lp-rating-val { font-size: 0.7rem; color: #64748B; margin-left: 3px; }
.lp-difficulty-pill { padding: 2px 8px; border-radius: 5px; font-size: 0.65rem; font-weight: 700; }
.lp-card-stats { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
.lp-stat { display: flex; align-items: center; gap: 4px; font-size: 0.7rem; color: #475569; }
.lp-stat--xp { font-weight: 700; color: #FACC15; }

/* Progress bar */
.lp-card-progress { display: flex; align-items: center; gap: 7px; }
.lp-progress-track { flex: 1; height: 4px; background: rgba(255,255,255,0.07); border-radius: 99px; overflow: hidden; }
.lp-progress-fill { height: 100%; background: linear-gradient(90deg, #00F5FF, #8B5CF6); border-radius: 99px; box-shadow: 0 0 6px rgba(0,245,255,0.35); transition: width 1s ease; }
.lp-progress-pct { font-size: 0.65rem; color: #00F5FF; font-weight: 700; white-space: nowrap; }

/* CTA */
.lp-card-cta { display: flex; align-items: center; gap: 7px; margin-top: auto; padding-top: 4px; }
.lp-btn {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 7px 13px; border-radius: 8px; font-size: 0.77rem; font-weight: 700;
  text-decoration: none; cursor: pointer; border: none; font-family: 'Inter', sans-serif;
  transition: box-shadow 0.25s ease, transform 0.2s ease;
  white-space: nowrap;
}
.lp-btn:hover { transform: scale(1.03); }
.lp-btn--start  { flex: 1; justify-content: center; background: linear-gradient(135deg, #00F5FF, #0891B2); color: #0B0F1A; }
.lp-btn--start:hover  { box-shadow: 0 0 14px rgba(0,245,255,0.35); }
.lp-btn--resume { flex: 1; justify-content: center; background: linear-gradient(135deg, #8B5CF6, #6D28D9); color: #fff; }
.lp-btn--resume:hover { box-shadow: 0 0 14px rgba(139,92,246,0.35); }
.lp-btn--done   { flex: 1; justify-content: center; background: linear-gradient(135deg, #39FF14, #22C55E); color: #0B0F1A; }
.lp-btn--done:hover   { box-shadow: 0 0 14px rgba(57,255,20,0.3); }
.lp-btn--lock   { flex: 1; justify-content: center; background: rgba(250,204,21,0.12); border: 1px solid rgba(250,204,21,0.25); color: #FACC15; }
.lp-btn--ghost  { padding: 7px 10px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); color: #64748B; }
.lp-btn--ghost:hover { color: #E2E8F0; border-color: rgba(255,255,255,0.15); }

/* Pagination */
.lp-pagination { display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin-top: 1.5rem; flex-wrap: wrap; }
.lp-page-btn {
  display: flex; align-items: center; gap: 5px;
  padding: 7px 14px; border-radius: 8px; font-size: 0.8rem; font-weight: 600;
  background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); color: #64748B;
  cursor: pointer; transition: all 0.2s ease; font-family: 'Inter', sans-serif;
}
.lp-page-btn:hover:not(:disabled) { background: rgba(0,245,255,0.08); color: #00F5FF; border-color: rgba(0,245,255,0.2); }
.lp-page-btn:disabled { opacity: 0.35; cursor: not-allowed; }
.lp-page-nums { display: flex; gap: 4px; }
.lp-page-num {
  width: 34px; height: 34px; border-radius: 8px; font-size: 0.8rem; font-weight: 600;
  background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06); color: #64748B;
  cursor: pointer; transition: all 0.2s ease; font-family: 'Inter', sans-serif;
}
.lp-page-num:hover { background: rgba(0,245,255,0.07); color: #00F5FF; }
.lp-page-num--active {
  background: rgba(0,245,255,0.12); border-color: rgba(0,245,255,0.3); color: #00F5FF;
  box-shadow: 0 0 10px rgba(0,245,255,0.12);
}

/* Empty / Error states */
.lp-empty-state, .lp-error-state {
  display: flex; flex-direction: column; align-items: center; gap: 0.75rem;
  padding: 4rem 1rem; text-align: center;
}
.lp-empty-state h3, .lp-error-state h3 { font-size: 1.1rem; font-weight: 700; color: #E2E8F0; margin: 0; }
.lp-empty-state p  { font-size: 0.85rem; color: #475569; margin: 0; }

/* Skeleton loader */
.lp-skeleton {
  background: rgba(15,20,35,0.75); border: 1px solid rgba(255,255,255,0.05);
  border-radius: 14px; overflow: hidden;
}
.lp-skeleton-img { height: 160px; background: linear-gradient(90deg, rgba(255,255,255,0.04) 0%, rgba(255,255,255,0.07) 50%, rgba(255,255,255,0.04) 100%); background-size: 200% 100%; animation: lp-shimmer 1.6s infinite; }
.lp-skeleton-body { padding: 1rem; display: flex; flex-direction: column; gap: 8px; }
.lp-skeleton-line { height: 10px; background: rgba(255,255,255,0.05); border-radius: 5px; animation: lp-shimmer 1.6s infinite; }
.lp-skeleton-line--title { height: 14px; width: 80%; }
.lp-skeleton-line--short { width: 50%; }
@keyframes lp-shimmer {
  0%   { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* Mobile drawer */
.lp-drawer-overlay {
  position: fixed; inset: 0; background: rgba(0,0,0,0.7); backdrop-filter: blur(4px);
  z-index: 1000; display: flex; align-items: flex-start; justify-content: flex-start;
}
.lp-drawer {
  width: min(320px, 90vw); height: 100vh; overflow-y: auto;
  background: rgba(11,15,26,0.97); border-right: 1px solid rgba(0,245,255,0.12);
  padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;
}
.lp-drawer-head {
  display: flex; align-items: center; justify-content: space-between; padding-bottom: 0.75rem;
  border-bottom: 1px solid rgba(255,255,255,0.07);
}
.lp-drawer-head button { background: none; border: none; color: #64748B; cursor: pointer; }
.lp-drawer-apply {
  width: 100%; padding: 11px; border-radius: 10px; margin-top: auto;
  background: linear-gradient(135deg, #00F5FF, #0891B2); color: #0B0F1A;
  font-weight: 700; font-size: 0.9rem; border: none; cursor: pointer; font-family: 'Inter', sans-serif;
}

/* RESPONSIVE */
@media (max-width: 1200px) {
  .lp-grid { grid-template-columns: repeat(2, 1fr); }
  .lp-main-layout { grid-template-columns: 240px 1fr; }
}
@media (max-width: 900px) {
  .lp-main-layout { grid-template-columns: 1fr; }
  .lp-sidebar-wrap { display: none; }
  .lp-mobile-filter-btn { display: flex; }
  .lp-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .lp-container { padding: 1rem; }
  .lp-grid { grid-template-columns: 1fr; }
  .lp-hstrip-item { width: 220px; }
  .lp-page-header { flex-direction: column; }
}



/* ==========================================
   LABS v2 — lp2 namespace
   ========================================== */

/* Root */
.lp2-root {
  min-height: 100vh;
  background: #0B0F1A;
  position: relative;
  padding-bottom: 4rem;
}
.lp2-bg-top {
  position: fixed; top: -160px; left: 50%; transform: translateX(-50%);
  width: 900px; height: 500px; border-radius: 50%; pointer-events: none;
  filter: blur(120px); z-index: 0; will-change: transform;
  background: radial-gradient(ellipse, rgba(0,245,255,0.045) 0%, rgba(139,92,246,0.03) 55%, transparent 70%);
}
.lp2-bg-right {
  position: fixed; top: 50%; right: -150px; width: 450px; height: 450px;
  border-radius: 50%; pointer-events: none; filter: blur(110px); z-index: 0; will-change: transform;
  background: radial-gradient(ellipse, rgba(139,92,246,0.055) 0%, transparent 65%);
}
.lp2-grid-bg {
  position: fixed; inset: 0; pointer-events: none; z-index: 0;
  background-image:
    linear-gradient(rgba(0,245,255,0.018) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,245,255,0.018) 1px, transparent 1px);
  background-size: 56px 56px;
  mask-image: radial-gradient(ellipse at 50% 25%, black 0%, transparent 72%);
  -webkit-mask-image: radial-gradient(ellipse at 50% 25%, black 0%, transparent 72%);
}

/* Wrapper */
.lp2-wrap {
  position: relative; z-index: 1;
  max-width: 1480px; margin: 0 auto;
  padding: 2rem 1.5rem;
  display: flex; flex-direction: column; gap: 1.5rem;
}

/* ── HEADER ── */
.lp2-header {
  display: flex; align-items: center; gap: 1.25rem;
  padding: 1.25rem 1.5rem;
  background: rgba(11,17,30,0.92);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 14px;
  flex-wrap: wrap;
}
.lp2-header-left { display: flex; align-items: center; gap: 1rem; flex: 1; min-width: 200px; }
.lp2-header-icon {
  width: 46px; height: 46px; border-radius: 12px; flex-shrink: 0;
  background: rgba(0,245,255,0.08); border: 1px solid rgba(0,245,255,0.2);
  display: flex; align-items: center; justify-content: center;
}
.lp2-h1 {
  font-family: 'Orbitron', sans-serif;
  font-size: clamp(1.4rem, 2.5vw, 1.9rem);
  font-weight: 800; color: #E2E8F0; margin: 0; letter-spacing: 0.03em;
  background: linear-gradient(90deg, #00F5FF, #8B5CF6);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.lp2-sub { font-size: 0.82rem; color: #475569; margin: 2px 0 0; }

/* Stats in header */
.lp2-header-stats { display: flex; gap: 1rem; flex-wrap: wrap; }
.lp2-hstat {
  display: flex; align-items: center; gap: 6px;
  padding: 6px 14px; border-radius: 8px;
  background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.07);
  font-size: 0.78rem; color: #64748B;
}
.lp2-hstat strong { color: #00F5FF; font-size: 0.95rem; font-family: 'Orbitron', sans-serif; }

/* Mobile filter button */
.lp2-mob-btn {
  display: none; align-items: center; gap: 7px;
  padding: 9px 16px; border-radius: 10px;
  background: rgba(0,245,255,0.08); border: 1px solid rgba(0,245,255,0.2);
  color: #00F5FF; font-size: 0.82rem; font-weight: 700;
  font-family: 'Inter', sans-serif; cursor: pointer; position: relative;
}
.lp2-mob-count {
  display: inline-flex; align-items: center; justify-content: center;
  width: 17px; height: 17px; border-radius: 50%;
  background: #00F5FF; color: #0B0F1A; font-size: 0.58rem; font-weight: 800;
}

/* ── BODY layout ── */
.lp2-body {
  display: grid;
  grid-template-columns: 270px 1fr;
  gap: 1.25rem;
  align-items: start;
}

/* ── SIDEBAR PANEL ── */
.lp2-panel {
  background: rgba(10,14,24,0.96);
  border: 1px solid rgba(0,245,255,0.1);
  border-radius: 14px;
  padding: 1.1rem;
  position: sticky; top: 72px;
  max-height: calc(100vh - 90px);
  overflow-y: auto;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: thin; scrollbar-color: rgba(0,245,255,0.12) transparent;
  box-shadow: 0 8px 28px rgba(0,0,0,0.3);
  display: flex; flex-direction: column; gap: 0.15rem;
}
.lp2-panel::-webkit-scrollbar { width: 3px; }
.lp2-panel::-webkit-scrollbar-thumb { background: rgba(0,245,255,0.15); border-radius: 99px; }

.lp2-panel-head {
  display: flex; align-items: center; justify-content: space-between;
  padding-bottom: 0.85rem; border-bottom: 1px solid rgba(255,255,255,0.06);
  margin-bottom: 0.5rem;
}
.lp2-panel-title {
  display: flex; align-items: center; gap: 6px;
  font-size: 0.78rem; font-weight: 700; letter-spacing: 0.07em;
  text-transform: uppercase; color: #64748B; font-family: 'Inter', sans-serif;
}
.lp2-panel-clear {
  display: flex; align-items: center; gap: 4px;
  font-size: 0.7rem; color: #FF3D71; font-weight: 600;
  background: rgba(255,61,113,0.08); border: 1px solid rgba(255,61,113,0.2);
  padding: 3px 9px; border-radius: 6px; cursor: pointer;
  font-family: 'Inter', sans-serif; transition: background 0.2s ease;
}
.lp2-panel-clear:hover { background: rgba(255,61,113,0.14); }

/* Search inside panel */
.lp2-search-wrap {
  position: relative; margin-bottom: 0.5rem;
}
.lp2-search-ico {
  position: absolute; left: 9px; top: 50%; transform: translateY(-50%); color: #334155;
  pointer-events: none;
}
.lp2-search-clr {
  position: absolute; right: 9px; top: 50%; transform: translateY(-50%);
  background: none; border: none; color: #475569; cursor: pointer;
}
.lp2-search-inp {
  width: 100%; padding: 8px 28px 8px 30px; border-radius: 8px; box-sizing: border-box;
  background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.07);
  color: #CBD5E1; font-size: 0.8rem; font-family: 'Inter', sans-serif; outline: none;
  transition: border-color 0.2s ease;
}
.lp2-search-inp:focus { border-color: rgba(0,245,255,0.28); box-shadow: 0 0 0 2px rgba(0,245,255,0.06); }
.lp2-search-inp::placeholder { color: #2D3748; }

/* Filter section */
.lp2-fs { border-top: 1px solid rgba(255,255,255,0.05); padding: 0.55rem 0; }
.lp2-fs-head {
  display: flex; align-items: center; justify-content: space-between;
  width: 100%; background: none; border: none; cursor: pointer; padding: 2px 0 5px;
  font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
  color: #475569; font-family: 'Inter', sans-serif;
}
.lp2-fs-body { display: flex; flex-direction: column; gap: 2px; padding-top: 2px; }

.lp2-opt {
  display: flex; align-items: center; gap: 8px;
  padding: 5px 7px; border-radius: 7px; cursor: pointer;
  transition: background 0.15s ease;
}
.lp2-opt:hover { background: rgba(255,255,255,0.04); }
.lp2-opt--on  { background: rgba(0,245,255,0.05); }
.lp2-opt input { accent-color: #00F5FF; cursor: pointer; flex-shrink: 0; }
.lp2-opt span { font-size: 0.8rem; color: #94A3B8; }
.lp2-opt--on span { color: #E2E8F0; }

.lp2-tag-cloud { display: flex; flex-wrap: wrap; gap: 5px; }
.lp2-tag {
  padding: 3px 9px; border-radius: 6px; font-size: 0.7rem; font-weight: 600;
  background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
  color: #64748B; cursor: pointer; transition: all 0.15s ease;
}
.lp2-tag--on {
  background: rgba(0,245,255,0.1); border-color: rgba(0,245,255,0.28); color: #00F5FF;
}

/* ── CONTENT AREA ── */
.lp2-content { display: flex; flex-direction: column; gap: 1rem; min-width: 0; }

/* Toolbar */
.lp2-bar {
  display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem;
  padding: 0.85rem 1.1rem;
  background: rgba(10,14,24,0.95); border: 1px solid rgba(255,255,255,0.07);
  border-radius: 12px;
}
.lp2-bar-count { font-size: 0.82rem; color: #475569; }
.lp2-bar-filter-badge { color: #8B5CF6; }
.lp2-bar-right { display: flex; align-items: center; gap: 0.65rem; }

/* Sort */
.lp2-sort { position: relative; display: flex; align-items: center; }
.lp2-sort-sel {
  padding: 7px 30px 7px 11px; border-radius: 8px;
  background: rgba(17,24,39,0.9); border: 1px solid rgba(255,255,255,0.08);
  color: #94A3B8; font-size: 0.79rem; font-weight: 600;
  appearance: none; cursor: pointer; outline: none; font-family: 'Inter', sans-serif;
  transition: border-color 0.2s ease;
}
.lp2-sort-sel:focus { border-color: rgba(0,245,255,0.22); }
.lp2-sort-arr {
  position: absolute; right: 9px; top: 50%; transform: translateY(-50%);
  color: #475569; pointer-events: none;
}

/* View toggle */
.lp2-view { display: flex; background: rgba(17,24,39,0.9); border: 1px solid rgba(255,255,255,0.07); border-radius: 8px; overflow: hidden; }
.lp2-vbtn { display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; background: none; border: none; color: #475569; cursor: pointer; transition: all 0.2s ease; }
.lp2-vbtn--on { background: rgba(0,245,255,0.12); color: #00F5FF; }
.lp2-vbtn:hover:not(.lp2-vbtn--on) { color: #94A3B8; }

/* ── GRID ── */
.lp2-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
}
.lp2-grid--list { grid-template-columns: 1fr; gap: 0.75rem; }

/* ── CARD ── */
.lp2-card {
  background: rgba(13,18,32,0.8);
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: 14px; overflow: hidden;
  display: flex; flex-direction: column;
  box-shadow: 0 4px 20px rgba(0,0,0,0.28);
  transition: transform 0.27s ease, border-color 0.27s ease, box-shadow 0.27s ease;
}
.lp2-card:hover {
  transform: translateY(-5px);
  border-color: rgba(0,245,255,0.22);
  box-shadow: 0 14px 36px rgba(0,0,0,0.42), 0 0 18px rgba(0,245,255,0.06);
}
.lp2-card--done  { border-color: rgba(57,255,20,0.14); }
.lp2-card--done:hover { border-color: rgba(57,255,20,0.28); box-shadow: 0 14px 36px rgba(0,0,0,0.42), 0 0 18px rgba(57,255,20,0.06); }
.lp2-card--locked { opacity: 0.88; }

/* Card image */
.lp2-card-img-wrap { position: relative; overflow: hidden; height: 155px; background: #080C14; flex-shrink: 0; }
.lp2-card-img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.45s ease; }
.lp2-card:hover .lp2-card-img { transform: scale(1.05); }

/* Badges */
.lp2-card-top-badges { position: absolute; top: 9px; right: 9px; display: flex; gap: 5px; flex-wrap: wrap; }
.lp2-card-bot-badges { position: absolute; bottom: 9px; left: 9px; }
.lp2-badge {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 3px 7px; border-radius: 5px; font-size: 0.63rem; font-weight: 800;
  letter-spacing: 0.04em; backdrop-filter: blur(8px);
}
.lp2-badge--pro  { background: rgba(250,204,21,0.88); color: #0B0F1A; }
.lp2-badge--free { background: rgba(57,255,20,0.88);  color: #0B0F1A; }
.lp2-badge--done { background: rgba(57,255,20,0.88);  color: #0B0F1A; }
.lp2-type {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 4px 8px; border-radius: 6px; font-size: 0.66rem; font-weight: 700;
  backdrop-filter: blur(8px);
}
.lp2-type--ctf  { background: rgba(139,92,246,0.88);  color: #fff; }
.lp2-type--walk { background: rgba(14,60,180,0.82); color: #fff; }

/* Lock layer */
.lp2-lock-layer {
  position: absolute; inset: 0;
  background: rgba(8,12,20,0.84); backdrop-filter: blur(6px);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 8px; color: #64748B; font-size: 0.75rem; font-weight: 600;
}
.lp2-upgrade-cta {
  padding: 5px 14px; border-radius: 7px; text-decoration: none;
  background: linear-gradient(135deg, #FACC15, #F97316); color: #0B0F1A;
  font-size: 0.74rem; font-weight: 800; transition: box-shadow 0.2s ease;
}
.lp2-upgrade-cta:hover { box-shadow: 0 0 12px rgba(250,204,21,0.38); }

/* Card body */
.lp2-card-body {
  padding: 0.9rem; display: flex; flex-direction: column; gap: 0.45rem; flex: 1;
}
.lp2-card-title {
  font-size: 0.88rem; font-weight: 700; color: #E2E8F0; line-height: 1.35; margin: 0;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  line-clamp: 2; overflow: hidden;
  transition: color 0.2s ease;
}
.lp2-card:hover .lp2-card-title { color: #00F5FF; }
.lp2-card-by { font-size: 0.69rem; color: #334155; margin: 0; }
.lp2-card-row { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap; }
.lp2-stars    { display: flex; align-items: center; gap: 2px; }
.lp2-stars-val { font-size: 0.68rem; color: #64748B; margin-left: 3px; }
.lp2-diff-pill { padding: 2px 8px; border-radius: 5px; font-size: 0.63rem; font-weight: 700; white-space: nowrap; }
.lp2-card-stats { display: flex; align-items: center; gap: 0.65rem; flex-wrap: wrap; }
.lp2-stat { display: flex; align-items: center; gap: 4px; font-size: 0.68rem; color: #475569; }
.lp2-stat--xp { color: #FACC15; font-weight: 700; }

/* Progress */
.lp2-prog-row { display: flex; align-items: center; gap: 7px; }
.lp2-prog-track { flex: 1; height: 4px; background: rgba(255,255,255,0.06); border-radius: 99px; overflow: hidden; }
.lp2-prog-fill { height: 100%; background: linear-gradient(90deg, #00F5FF, #8B5CF6); border-radius: 99px; transition: width 1s ease; }
.lp2-prog-pct { font-size: 0.63rem; color: #00F5FF; font-weight: 700; }

/* CTA */
.lp2-card-cta { display: flex; align-items: center; gap: 6px; margin-top: auto; padding-top: 4px; }
.lp2-btn {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 7px 14px; border-radius: 8px; font-size: 0.77rem; font-weight: 700;
  text-decoration: none; cursor: pointer; border: none;
  font-family: 'Inter', sans-serif;
  transition: box-shadow 0.2s ease, transform 0.18s ease;
  white-space: nowrap; color: inherit;
}
.lp2-btn:hover { transform: scale(1.03); }
.lp2-btn--start  { flex: 1; justify-content: center; background: linear-gradient(135deg,#00F5FF,#0891B2); color: #0B0F1A; }
.lp2-btn--start:hover  { box-shadow: 0 0 14px rgba(0,245,255,0.3); }
.lp2-btn--resume { flex: 1; justify-content: center; background: linear-gradient(135deg,#8B5CF6,#6D28D9); color: #fff; }
.lp2-btn--resume:hover { box-shadow: 0 0 14px rgba(139,92,246,0.3); }
.lp2-btn--done   { flex: 1; justify-content: center; background: linear-gradient(135deg,#39FF14,#22C55E); color: #0B0F1A; }
.lp2-btn--done:hover   { box-shadow: 0 0 14px rgba(57,255,20,0.28); }
.lp2-btn--lock   { flex: 1; justify-content: center; background: rgba(250,204,21,0.1); border: 1px solid rgba(250,204,21,0.22); color: #FACC15; }
.lp2-btn--icon   { padding: 7px 10px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); color: #64748B; }
.lp2-btn--icon:hover { color: #E2E8F0; border-color: rgba(255,255,255,0.15); }

/* ── LIST ROW ── */
.lp2-row {
  display: flex; align-items: center; gap: 1rem;
  padding: 0.9rem; border-radius: 12px;
  background: rgba(13,18,32,0.8); border: 1px solid rgba(255,255,255,0.07);
  transition: border-color 0.22s ease, transform 0.22s ease;
}
.lp2-row:hover { border-color: rgba(0,245,255,0.18); transform: translateX(3px); }
.lp2-row-img { width: 90px; height: 65px; object-fit: cover; border-radius: 8px; flex-shrink: 0; }
.lp2-row-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.4rem; }
.lp2-row-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem; }
.lp2-row-title { font-size: 0.88rem; font-weight: 700; color: #E2E8F0; margin: 0; }
.lp2-row-by    { font-size: 0.68rem; color: #334155; margin: 2px 0 0; }
.lp2-row-badges { display: flex; align-items: center; gap: 5px; flex-wrap: wrap; flex-shrink: 0; }
.lp2-row-meta { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
.lp2-row-cta { flex-shrink: 0; }

/* ── SKELETON ── */
.lp2-skel { background: rgba(13,18,32,0.8); border: 1px solid rgba(255,255,255,0.05); border-radius: 14px; overflow: hidden; }
.lp2-skel-img { height: 155px; background: linear-gradient(90deg, rgba(255,255,255,0.04) 0%, rgba(255,255,255,0.07) 50%, rgba(255,255,255,0.04) 100%); background-size: 200% 100%; animation: lp2-shimmer 1.5s infinite; }
.lp2-skel-bd { padding: 0.9rem; display: flex; flex-direction: column; gap: 8px; }
.lp2-skel-ln { height: 10px; background: rgba(255,255,255,0.05); border-radius: 4px; animation: lp2-shimmer 1.5s infinite; }
.lp2-skel-ln--lg { height: 14px; width: 75%; }
.lp2-skel-ln--sm { width: 45%; }
@keyframes lp2-shimmer { 0%{background-position:200% 0} 100%{background-position:-200% 0} }

/* ── STATE (empty / error) ── */
.lp2-state {
  display: flex; flex-direction: column; align-items: center; gap: 0.85rem;
  padding: 4rem 1rem; text-align: center;
  background: rgba(13,18,32,0.6); border: 1px solid rgba(255,255,255,0.06);
  border-radius: 14px;
}
.lp2-state-icon {
  width: 64px; height: 64px; border-radius: 50%;
  background: rgba(0,245,255,0.08); border: 1px solid rgba(0,245,255,0.15);
  display: flex; align-items: center; justify-content: center; color: #00F5FF;
}
.lp2-state-icon--red { background: rgba(255,61,113,0.08); border-color: rgba(255,61,113,0.2); color: #FF3D71; }
.lp2-state h3 { font-size: 1rem; font-weight: 700; color: #E2E8F0; margin: 0; }
.lp2-state p  { font-size: 0.82rem; color: #475569; margin: 0; max-width: 320px; }

/* ── PAGINATION ── */
.lp2-pages { display: flex; align-items: center; justify-content: center; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.5rem; }
.lp2-pg-btn {
  display: flex; align-items: center; gap: 5px;
  padding: 7px 14px; border-radius: 8px; font-size: 0.79rem; font-weight: 600;
  background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
  color: #64748B; cursor: pointer; transition: all 0.2s ease; font-family: 'Inter', sans-serif;
}
.lp2-pg-btn:hover:not(:disabled) { background: rgba(0,245,255,0.07); color: #00F5FF; border-color: rgba(0,245,255,0.2); }
.lp2-pg-btn:disabled { opacity: 0.32; cursor: not-allowed; }
.lp2-pg-nums { display: flex; gap: 4px; }
.lp2-pg-num {
  width: 34px; height: 34px; border-radius: 8px; font-size: 0.79rem; font-weight: 600;
  background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.07);
  color: #64748B; cursor: pointer; transition: all 0.2s ease; font-family: 'Inter', sans-serif;
}
.lp2-pg-num:hover { background: rgba(0,245,255,0.07); color: #00F5FF; }
.lp2-pg-num--on {
  background: rgba(0,245,255,0.11); border-color: rgba(0,245,255,0.28); color: #00F5FF;
  box-shadow: 0 0 10px rgba(0,245,255,0.1);
}

/* ── MOBILE DRAWER ── */
.lp2-overlay {
  position: fixed; inset: 0; background: rgba(0,0,0,0.72); backdrop-filter: blur(5px);
  z-index: 1200; display: flex; align-items: flex-start; justify-content: flex-start;
}
.lp2-drawer {
  width: min(310px, 88vw); height: 100dvh; overflow: hidden;
  background: rgba(10,14,25,0.98); border-right: 1px solid rgba(0,245,255,0.12);
  display: flex; flex-direction: column; gap: 0;
}
.lp2-drawer-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 1rem 1.25rem; border-bottom: 1px solid rgba(255,255,255,0.07);
  flex-shrink: 0;
}
.lp2-drawer-close { background: none; border: none; color: #64748B; cursor: pointer; }
.lp2-drawer-apply {
  flex-shrink: 0; width: 100%; padding: 12px; margin: 0;
  background: linear-gradient(135deg, #00F5FF, #0891B2); color: #0B0F1A;
  font-weight: 700; font-size: 0.88rem; border: none; cursor: pointer;
  font-family: 'Inter', sans-serif;
}

/* ── RESPONSIVE ── */
@media (max-width: 1280px) {
  .lp2-grid { grid-template-columns: repeat(2, 1fr); }
  .lp2-body { grid-template-columns: 250px 1fr; }
}
@media (max-width: 960px) {
  .lp2-body { grid-template-columns: 1fr; }
  .lp2-sidebar { display: none; }
  .lp2-mob-btn { display: flex; }
  .lp2-grid { grid-template-columns: repeat(2, 1fr); }
  .lp2-header-stats { display: none; }
}
@media (max-width: 580px) {
  .lp2-wrap { padding: 1rem; }
  .lp2-grid { grid-template-columns: 1fr; }
  .lp2-row-img { display: none; }
}


/* ==========================================
   ROOMS v2 — rp namespace
   ========================================== */

.rp-root {
  min-height: 100vh; background: #0B0F1A;
  position: relative; padding-bottom: 4rem;
}
.rp-bg-tl {
  position: fixed; top: -140px; left: -120px;
  width: 600px; height: 600px; border-radius: 50%; pointer-events: none;
  filter: blur(130px); z-index: 0; will-change: transform;
  background: radial-gradient(ellipse, rgba(139,92,246,0.06) 0%, transparent 65%);
}
.rp-bg-br {
  position: fixed; bottom: -120px; right: -100px;
  width: 520px; height: 520px; border-radius: 50%; pointer-events: none;
  filter: blur(110px); z-index: 0; will-change: transform;
  background: radial-gradient(ellipse, rgba(0,245,255,0.045) 0%, transparent 65%);
}
.rp-grid-bg {
  position: fixed; inset: 0; pointer-events: none; z-index: 0;
  background-image:
    linear-gradient(rgba(139,92,246,0.015) 1px, transparent 1px),
    linear-gradient(90deg, rgba(139,92,246,0.015) 1px, transparent 1px);
  background-size: 56px 56px;
  mask-image: radial-gradient(ellipse at 40% 30%, black 0%, transparent 70%);
  -webkit-mask-image: radial-gradient(ellipse at 40% 30%, black 0%, transparent 70%);
}

/* Wrapper */
.rp-wrap {
  position: relative; z-index: 1; max-width: 1480px;
  margin: 0 auto; padding: 2rem 1.5rem;
  display: flex; flex-direction: column; gap: 1.5rem;
}

/* ── HEADER ── */
.rp-header {
  display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap;
  padding: 1.25rem 1.5rem;
  background: rgba(10,14,24,0.96); border: 1px solid rgba(255,255,255,0.08);
  border-radius: 14px;
}
.rp-header-left { display: flex; align-items: center; gap: 1rem; flex: 1; min-width: 200px; }
.rp-header-icon {
  width: 46px; height: 46px; border-radius: 12px; flex-shrink: 0;
  background: rgba(139,92,246,0.1); border: 1px solid rgba(139,92,246,0.26);
  display: flex; align-items: center; justify-content: center;
}
.rp-h1 {
  font-family: 'Orbitron', sans-serif;
  font-size: clamp(1.4rem, 2.5vw, 1.9rem); font-weight: 800; margin: 0;
  background: linear-gradient(90deg, #8B5CF6, #00F5FF);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.rp-sub { font-size: 0.82rem; color: #475569; margin: 2px 0 0; }

.rp-header-stats { display: flex; gap: 0.75rem; flex-wrap: wrap; }
.rp-hstat {
  display: flex; align-items: center; gap: 6px; padding: 6px 13px;
  border-radius: 8px; background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.07);
  font-size: 0.77rem; color: #64748B;
}
.rp-hstat strong { font-size: 0.95rem; font-family: 'Orbitron', sans-serif; }

.rp-mob-btn {
  display: none; align-items: center; gap: 7px; padding: 9px 16px;
  border-radius: 10px; background: rgba(139,92,246,0.1); border: 1px solid rgba(139,92,246,0.25);
  color: #8B5CF6; font-size: 0.82rem; font-weight: 700;
  font-family: 'Inter', sans-serif; cursor: pointer; position: relative;
}
.rp-mob-count {
  display: inline-flex; align-items: center; justify-content: center;
  width: 17px; height: 17px; border-radius: 50%;
  background: #8B5CF6; color: #fff; font-size: 0.58rem; font-weight: 800;
}

/* ── BODY ── */
.rp-body { display: grid; grid-template-columns: 270px 1fr; gap: 1.25rem; align-items: start; }

/* ── SIDEBAR ── */
.rp-panel {
  background: rgba(10,14,24,0.96); border: 1px solid rgba(139,92,246,0.12);
  border-radius: 14px; padding: 1.1rem;
  position: sticky; top: 72px;
  max-height: calc(100vh - 90px); overflow-y: auto;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: thin; scrollbar-color: rgba(139,92,246,0.15) transparent;
  box-shadow: 0 8px 28px rgba(0,0,0,0.3);
  display: flex; flex-direction: column; gap: 0.1rem;
}
.rp-panel::-webkit-scrollbar { width: 3px; }
.rp-panel::-webkit-scrollbar-thumb { background: rgba(139,92,246,0.18); border-radius: 99px; }

.rp-panel-head {
  display: flex; align-items: center; justify-content: space-between;
  padding-bottom: 0.8rem; border-bottom: 1px solid rgba(255,255,255,0.06); margin-bottom: 0.4rem;
}
.rp-panel-title {
  display: flex; align-items: center; gap: 6px;
  font-size: 0.78rem; font-weight: 700; letter-spacing: 0.07em;
  text-transform: uppercase; color: #64748B;
}
.rp-panel-clear {
  display: flex; align-items: center; gap: 4px; font-size: 0.7rem; color: #FF3D71;
  background: rgba(255,61,113,0.08); border: 1px solid rgba(255,61,113,0.2);
  padding: 3px 9px; border-radius: 6px; cursor: pointer; font-family: 'Inter', sans-serif;
  transition: background 0.2s;
}
.rp-panel-clear:hover { background: rgba(255,61,113,0.15); }

.rp-search-wrap { position: relative; margin-bottom: 0.5rem; }
.rp-search-ico { position: absolute; left: 9px; top: 50%; transform: translateY(-50%); color: #334155; pointer-events: none; }
.rp-search-clr { position: absolute; right: 9px; top: 50%; transform: translateY(-50%); background: none; border: none; color: #475569; cursor: pointer; }
.rp-search-inp {
  width: 100%; padding: 8px 28px 8px 30px; border-radius: 8px; box-sizing: border-box;
  background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.07);
  color: #CBD5E1; font-size: 0.8rem; outline: none; font-family: 'Inter', sans-serif;
  transition: border-color 0.2s;
}
.rp-search-inp:focus { border-color: rgba(139,92,246,0.3); box-shadow: 0 0 0 2px rgba(139,92,246,0.07); }
.rp-search-inp::placeholder { color: #2D3748; }

.rp-fs { border-top: 1px solid rgba(255,255,255,0.05); padding: 0.5rem 0; }
.rp-fs-head {
  display: flex; align-items: center; justify-content: space-between;
  width: 100%; background: none; border: none; cursor: pointer; padding: 2px 0 5px;
  font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
  color: #475569; font-family: 'Inter', sans-serif;
}
.rp-fs-body { display: flex; flex-direction: column; gap: 2px; padding-top: 2px; }

.rp-opt {
  display: flex; align-items: center; gap: 8px; padding: 5px 7px;
  border-radius: 7px; cursor: pointer; transition: background 0.15s;
}
.rp-opt:hover { background: rgba(255,255,255,0.04); }
.rp-opt--on  { background: rgba(139,92,246,0.07); }
.rp-opt input { accent-color: #8B5CF6; cursor: pointer; flex-shrink: 0; }
.rp-opt span  { font-size: 0.8rem; color: #94A3B8; display: flex; align-items: center; gap: 5px; }
.rp-opt--on span { color: #E2E8F0; }

.rp-tag-cloud { display: flex; flex-wrap: wrap; gap: 5px; }
.rp-tag {
  padding: 3px 9px; border-radius: 6px; font-size: 0.7rem; font-weight: 600;
  background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
  color: #64748B; cursor: pointer; transition: all 0.15s;
}
.rp-tag--on { background: rgba(139,92,246,0.12); border-color: rgba(139,92,246,0.3); color: #8B5CF6; }

/* ── CONTENT ── */
.rp-content { display: flex; flex-direction: column; gap: 1rem; min-width: 0; }

/* Toolbar */
.rp-bar {
  display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem;
  padding: 0.85rem 1.1rem;
  background: rgba(10,14,24,0.95); border: 1px solid rgba(255,255,255,0.07);
  border-radius: 12px;
}
.rp-bar-count { font-size: 0.82rem; color: #475569; }
.rp-bar-flt   { color: #8B5CF6; }
.rp-bar-right { display: flex; align-items: center; gap: 0.65rem; }

.rp-sort { position: relative; display: flex; align-items: center; }
.rp-sort-sel {
  padding: 7px 30px 7px 11px; border-radius: 8px;
  background: rgba(17,24,39,0.9); border: 1px solid rgba(255,255,255,0.08);
  color: #94A3B8; font-size: 0.79rem; font-weight: 600;
  appearance: none; cursor: pointer; outline: none; font-family: 'Inter', sans-serif;
}
.rp-sort-arr { position: absolute; right: 9px; top: 50%; transform: translateY(-50%); color: #475569; pointer-events: none; }

.rp-view { display: flex; background: rgba(17,24,39,0.9); border: 1px solid rgba(255,255,255,0.07); border-radius: 8px; overflow: hidden; }
.rp-vbtn { display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; background: none; border: none; color: #475569; cursor: pointer; transition: all 0.2s; }
.rp-vbtn--on { background: rgba(139,92,246,0.15); color: #8B5CF6; }
.rp-vbtn:hover:not(.rp-vbtn--on) { color: #94A3B8; }

/* ── GRID ── */
.rp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
.rp-grid--list { grid-template-columns: 1fr; gap: 0.75rem; }

/* ── CARD ── */
.rp-card {
  background: rgba(13,18,32,0.82); border: 1px solid rgba(255,255,255,0.07);
  border-radius: 14px; overflow: hidden;
  display: flex; flex-direction: column;
  box-shadow: 0 4px 20px rgba(0,0,0,0.28);
  transition: transform 0.27s ease, border-color 0.27s ease, box-shadow 0.27s ease;
}
.rp-card:hover {
  transform: translateY(-5px);
  border-color: rgba(139,92,246,0.28);
  box-shadow: 0 14px 36px rgba(0,0,0,0.42), 0 0 22px rgba(139,92,246,0.08);
}
.rp-card--done { border-color: rgba(57,255,20,0.14); }
.rp-card--done:hover { border-color: rgba(57,255,20,0.3); box-shadow: 0 14px 36px rgba(0,0,0,0.42), 0 0 18px rgba(57,255,20,0.06); }

/* Card image */
.rp-card-img-wrap { position: relative; overflow: hidden; height: 155px; background: #080C14; flex-shrink: 0; }
.rp-card-img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.45s ease; }
.rp-card:hover .rp-card-img { transform: scale(1.06); }

/* Difficulty bar at bottom of image */
.rp-diff-bar-track { position: absolute; bottom: 0; left: 0; right: 0; height: 3px; background: rgba(0,0,0,0.5); }
.rp-diff-bar-fill  { height: 100%; transition: width 1s ease; }

.rp-card-top-r { position: absolute; top: 9px; right: 9px; display: flex; gap: 5px; }
.rp-card-bot-l  { position: absolute; bottom: 9px; left: 9px; }

/* Badges */
.rp-badge {
  display: inline-flex; align-items: center; gap: 3px;
  padding: 3px 7px; border-radius: 5px; font-size: 0.62rem; font-weight: 800;
  letter-spacing: 0.04em; backdrop-filter: blur(8px);
}
.rp-badge--pro  { background: rgba(250,204,21,0.92); color: #0B0F1A; }
.rp-badge--free { background: rgba(57,255,20,0.88);  color: #0B0F1A; }
.rp-badge--done { background: rgba(57,255,20,0.88);  color: #0B0F1A; }

.rp-cat-tag {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 3px 8px; border-radius: 6px; font-size: 0.65rem; font-weight: 700;
  border: 1px solid transparent; backdrop-filter: blur(8px);
}

/* Bookmark btn */
.rp-bm-btn {
  position: absolute; top: 9px; left: 9px;
  width: 30px; height: 30px; border-radius: 8px;
  background: rgba(0,0,0,0.55); backdrop-filter: blur(6px);
  border: 1px solid rgba(255,255,255,0.1); color: #94A3B8;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; transition: all 0.2s;
}
.rp-bm-btn--on { background: rgba(250,204,21,0.88); color: #0B0F1A; border-color: transparent; }
.rp-bm-btn:hover:not(.rp-bm-btn--on) { background: rgba(0,0,0,0.78); color: #E2E8F0; }

/* Card body */
.rp-card-body { padding: 0.9rem; display: flex; flex-direction: column; gap: 0.45rem; flex: 1; }

.rp-card-title {
  font-size: 0.88rem; font-weight: 700; color: #E2E8F0; line-height: 1.35; margin: 0;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  overflow: hidden; transition: color 0.2s;
}
.rp-card:hover .rp-card-title { color: #8B5CF6; }
.rp-card-desc { font-size: 0.69rem; color: #334155; margin: 0; line-clamp: 2;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

.rp-card-meta  { display: flex; align-items: center; gap: 0.7rem; flex-wrap: wrap; }
.rp-meta-item  { display: flex; align-items: center; gap: 4px; font-size: 0.68rem; color: #475569; }
.rp-meta-item--xp { color: #FACC15; font-weight: 700; }

.rp-diff-row   { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.rp-diff-pill  { padding: 2px 8px; border-radius: 5px; font-size: 0.63rem; font-weight: 700; white-space: nowrap; }
.rp-topic-count { display: flex; align-items: center; gap: 4px; font-size: 0.67rem; color: #334155; }

/* Progress */
.rp-prog-row  { display: flex; align-items: center; gap: 7px; }
.rp-prog-track { flex: 1; height: 4px; background: rgba(255,255,255,0.06); border-radius: 99px; overflow: hidden; }
.rp-prog-fill  { height: 100%; background: linear-gradient(90deg, #8B5CF6, #00F5FF); border-radius: 99px; transition: width 1s ease; }
.rp-prog-pct   { font-size: 0.63rem; color: #8B5CF6; font-weight: 700; }

/* CTA */
.rp-card-cta { display: flex; align-items: center; gap: 6px; margin-top: auto; padding-top: 4px; }
.rp-btn {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 7px 14px; border-radius: 8px; font-size: 0.77rem; font-weight: 700;
  text-decoration: none; cursor: pointer; border: none;
  font-family: 'Inter', sans-serif; color: inherit;
  transition: box-shadow 0.2s ease, transform 0.18s ease; white-space: nowrap;
}
.rp-btn:hover { transform: scale(1.03); }
.rp-btn--start  { flex: 1; justify-content: center; background: linear-gradient(135deg, #8B5CF6, #6D28D9); color: #fff; }
.rp-btn--start:hover  { box-shadow: 0 0 14px rgba(139,92,246,0.38); }
.rp-btn--resume { flex: 1; justify-content: center; background: linear-gradient(135deg, #00F5FF, #0891B2); color: #0B0F1A; }
.rp-btn--resume:hover { box-shadow: 0 0 14px rgba(0,245,255,0.3); }
.rp-btn--done   { flex: 1; justify-content: center; background: linear-gradient(135deg, #39FF14, #22C55E); color: #0B0F1A; }
.rp-btn--done:hover   { box-shadow: 0 0 14px rgba(57,255,20,0.28); }
.rp-btn--icon   { padding: 7px 10px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); color: #64748B; }
.rp-btn--icon:hover { color: #E2E8F0; border-color: rgba(255,255,255,0.15); }

/* ── LIST ROW ── */
.rp-row {
  display: flex; align-items: center; gap: 1rem; padding: 0.9rem; border-radius: 12px;
  background: rgba(13,18,32,0.82); border: 1px solid rgba(255,255,255,0.07);
  transition: border-color 0.22s ease, transform 0.22s ease;
}
.rp-row:hover { border-color: rgba(139,92,246,0.22); transform: translateX(3px); }
.rp-row--done { border-color: rgba(57,255,20,0.14); }
.rp-row-img   { width: 90px; height: 65px; object-fit: cover; border-radius: 8px; flex-shrink: 0; }
.rp-row-body  { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.4rem; }
.rp-row-top   { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem; }
.rp-row-title { font-size: 0.88rem; font-weight: 700; color: #E2E8F0; margin: 0; }
.rp-row-desc  { font-size: 0.68rem; color: #334155; margin: 2px 0 0; }
.rp-row-badges { display: flex; align-items: center; gap: 5px; flex-wrap: wrap; flex-shrink: 0; }
.rp-row-meta   { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
.rp-row-actions { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
.rp-bm-btn-sm {
  width: 30px; height: 30px; border-radius: 8px;
  background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); color: #64748B;
  display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s;
}
.rp-bm-btn-sm--on { background: rgba(250,204,21,0.88); color: #0B0F1A; border-color: transparent; }

/* ── SKELETON ── */
.rp-skel { background: rgba(13,18,32,0.8); border: 1px solid rgba(255,255,255,0.05); border-radius: 14px; overflow: hidden; }
.rp-skel-img { height: 155px; background: linear-gradient(90deg, rgba(255,255,255,0.04) 0%, rgba(255,255,255,0.07) 50%, rgba(255,255,255,0.04) 100%); background-size: 200% 100%; animation: rp-shimmer 1.5s infinite; }
.rp-skel-bd  { padding: 0.9rem; display: flex; flex-direction: column; gap: 8px; }
.rp-skel-ln  { height: 10px; background: rgba(255,255,255,0.05); border-radius: 4px; animation: rp-shimmer 1.5s infinite; }
.rp-skel-ln--lg { height: 14px; width: 72%; }
.rp-skel-ln--sm { width: 42%; }
@keyframes rp-shimmer { 0%{background-position:200% 0} 100%{background-position:-200% 0} }

/* ── STATE ── */
.rp-state {
  display: flex; flex-direction: column; align-items: center; gap: 0.85rem;
  padding: 4rem 1rem; text-align: center;
  background: rgba(13,18,32,0.6); border: 1px solid rgba(255,255,255,0.06); border-radius: 14px;
}
.rp-state-ico {
  width: 64px; height: 64px; border-radius: 50%;
  background: rgba(139,92,246,0.08); border: 1px solid rgba(139,92,246,0.18);
  display: flex; align-items: center; justify-content: center; color: #8B5CF6;
}
.rp-state-ico--red { background: rgba(255,61,113,0.08); border-color: rgba(255,61,113,0.2); color: #FF3D71; }
.rp-state h3 { font-size: 1rem; font-weight: 700; color: #E2E8F0; margin: 0; }
.rp-state p  { font-size: 0.82rem; color: #475569; margin: 0; max-width: 320px; }

/* ── MOBILE DRAWER ── */
.rp-overlay {
  position: fixed; inset: 0; background: rgba(0,0,0,0.72); backdrop-filter: blur(5px);
  z-index: 1200; display: flex; align-items: flex-start; justify-content: flex-start;
}
.rp-drawer {
  width: min(310px, 88vw); height: 100dvh; overflow: hidden;
  background: rgba(10,14,25,0.98); border-right: 1px solid rgba(139,92,246,0.15);
  display: flex; flex-direction: column;
}
.rp-drawer-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 1rem 1.25rem; border-bottom: 1px solid rgba(255,255,255,0.07); flex-shrink: 0;
}
.rp-drawer-close { background: none; border: none; color: #64748B; cursor: pointer; }
.rp-drawer-apply {
  flex-shrink: 0; width: 100%; padding: 12px; margin: 0;
  background: linear-gradient(135deg, #8B5CF6, #6D28D9); color: #fff;
  font-weight: 700; font-size: 0.88rem; border: none; cursor: pointer;
  font-family: 'Inter', sans-serif;
}

/* ── RESPONSIVE ── */
@media (max-width: 1280px) {
  .rp-grid { grid-template-columns: repeat(2, 1fr); }
  .rp-body { grid-template-columns: 250px 1fr; }
}
@media (max-width: 960px) {
  .rp-body { grid-template-columns: 1fr; }
  .rp-sidebar { display: none; }
  .rp-mob-btn { display: flex; }
  .rp-grid { grid-template-columns: repeat(2, 1fr); }
  .rp-header-stats { display: none; }
}
@media (max-width: 580px) {
  .rp-wrap { padding: 1rem; }
  .rp-grid { grid-template-columns: 1fr; }
  .rp-row-img { display: none; }
}

/* ==========================================
   ROOM DETAIL PAGE — rdp namespace
   ========================================== */

.rdp-root {
  min-height: 100vh;
  background: #0B0F1A;
  position: relative;
  color: #E2E8F0;
}

/* Background Effects */
.rdp-bg-glow {
  position: fixed; top: -150px; left: 50%; transform: translateX(-50%);
  width: min(100vw, 1200px); height: 600px;
  background: radial-gradient(ellipse, rgba(139,92,246,0.06) 0%, rgba(0,245,255,0.03) 50%, transparent 75%);
  filter: blur(120px); z-index: 0; pointer-events: none;
}

.rdp-wrap {
  position: relative; z-index: 10;
  max-width: 1440px; margin: 0 auto; padding: 2rem 1.5rem;
  display: flex; flex-direction: column; gap: 2rem;
}

/* ── STICKY NAV ── */
.rdp-nav {
  position: sticky; top: 0; z-index: 100;
  background: rgba(11, 15, 26, 0.95);
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(12px);
  padding: 0.75rem 0;
}
.rdp-nav-content {
  max-width: 1440px; margin: 0 auto; padding: 0 1.5rem;
  display: flex; align-items: center; justify-content: space-between; gap: 1rem;
}
.rdp-nav-left { display: flex; align-items: center; gap: 1rem; }
.rdp-back-btn {
  display: flex; align-items: center; gap: 8px;
  color: #94A3B8; font-size: 0.85rem; font-weight: 600;
  padding: 8px 12px; border-radius: 8px; transition: 0.2s;
  background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);
}
.rdp-back-btn:hover { color: #fff; background: rgba(255,255,255,0.08); }

.rdp-prog-wrap { flex: 1; max-width: 600px; }
.rdp-prog-text { font-size: 0.75rem; color: #64748B; font-weight: 700; text-transform: uppercase; margin-bottom: 6px; display: block; }
.rdp-prog-track { height: 6px; background: rgba(255,255,255,0.05); border-radius: 99px; overflow: hidden; position: relative; }
.rdp-prog-fill { height: 100%; background: linear-gradient(90deg, #8B5CF6, #00F5FF); transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1); }

/* ── HERO ── */
.rdp-hero {
  display: grid; grid-template-columns: 1fr 380px; gap: 2.5rem;
  background: rgba(17, 24, 39, 0.6);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 24px; padding: 2.5rem;
  backdrop-filter: blur(10px);
}
.rdp-hero-info { display: flex; flex-direction: column; gap: 1.5rem; }
.rdp-cat-pill {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 6px 14px; border-radius: 99px;
  font-size: 0.8rem; font-weight: 700; width: fit-content;
}
.rdp-title {
  font-family: 'Orbitron', sans-serif; font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 800; line-height: 1.1; margin: 0;
  background: linear-gradient(135deg, #fff, #94A3B8);
  -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
}
.rdp-desc { font-size: 1.1rem; color: #94A3B8; line-height: 1.6; max-width: 800px; margin: 0; }
.rdp-meta { display: flex; align-items: center; gap: 2rem; }
.rdp-m-item { display: flex; align-items: center; gap: 10px; color: #E2E8F0; }
.rdp-m-item svg { color: #8B5CF6; }
.rdp-m-val { font-weight: 700; font-size: 1rem; }
.rdp-m-lbl { font-size: 0.75rem; color: #64748B; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 2px; }

.rdp-hero-card {
  background: rgba(13, 18, 32, 0.8);
  border: 1px solid rgba(139, 92, 246, 0.25);
  border-radius: 20px; overflow: hidden;
  box-shadow: 0 20px 40px rgba(0,0,0,0.4), 0 0 20px rgba(139,92,246,0.1);
}
.rdp-hero-img-wrap { height: 200px; position: relative; }
.rdp-hero-img { width: 100%; height: 100%; object-fit: cover; }
.rdp-hero-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 50%, #0D1220); }
.rdp-hero-actions { padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; }

.rdp-main-btn {
  width: 100%; padding: 1rem; border-radius: 12px; border: none;
  font-family: 'Inter', sans-serif; font-weight: 800; font-size: 1.05rem;
  cursor: pointer; transition: 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  display: flex; align-items: center; justify-content: center; gap: 10px;
  background: linear-gradient(135deg, #8B5CF6, #6D28D9); color: #fff;
  box-shadow: 0 4px 15px rgba(139, 92, 246, 0.3);
}
.rdp-main-btn:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(139, 92, 246, 0.5); }
.rdp-main-btn svg { transition: transform 0.3s; }
.rdp-main-btn:hover svg { transform: translateX(3px); }

/* ── CONTENT LAYOUT ── */
.rdp-layout { display: grid; grid-template-columns: 320px 1fr 280px; gap: 2rem; }

/* Task Sidebar */
.rdp-sidebar { display: flex; flex-direction: column; gap: 1.5rem; position: sticky; top: 100px; height: fit-content; }
.rdp-s-title { font-size: 1rem; font-weight: 800; color: #fff; display: flex; align-items: center; gap: 10px; padding: 0 0.5rem; }
.rdp-s-list { display: flex; flex-direction: column; gap: 10px; }
.rdp-t-item {
  width: 100%; padding: 0.85rem; border-radius: 14px; border: 1px solid rgba(255,255,255,0.06);
  background: rgba(255,255,255,0.02); color: #94A3B8; text-align: left;
  transition: 0.2s; display: flex; align-items: center; gap: 12px; cursor: pointer;
}
.rdp-t-item:hover { background: rgba(255,255,255,0.06); color: #fff; border-color: rgba(255,255,255,0.15); }
.rdp-t-item--active { background: rgba(139, 92, 246, 0.1); border-color: rgba(139, 92, 246, 0.3); color: #fff; }
.rdp-t-item--done { background: rgba(57, 255, 20, 0.05); border-color: rgba(57, 255, 20, 0.15); }
.rdp-t-item--locked { opacity: 0.5; cursor: not-allowed; }

.rdp-t-icon {
  width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,0.05); color: #64748B; flex-shrink: 0;
}
.rdp-t-item--active .rdp-t-icon { background: rgba(139, 92, 246, 0.2); color: #8B5CF6; }
.rdp-t-item--done .rdp-t-icon { background: rgba(57, 255, 20, 0.1); color: #39FF14; }

.rdp-t-title { font-size: 0.85rem; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* Content Area */
.rdp-content { display: flex; flex-direction: column; gap: 1.5rem; }
.rdp-card {
  background: rgba(17, 24, 39, 0.5);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 20px; overflow: hidden;
}
.rdp-card-head { padding: 1.5rem 2rem; border-bottom: 1px solid rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: space-between; }
.rdp-card-title { font-size: 1.5rem; font-weight: 800; color: #fff; margin: 0; }
.rdp-card-body { padding: 2rem; }

.rdp-prose { color: #CBD5E1; font-size: 1rem; line-height: 1.8; }
.rdp-prose p { margin-bottom: 1.5rem; }
.rdp-prose strong { color: #fff; }

.rdp-code-wrap {
  margin: 1.5rem 0; background: #0F172A; border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; overflow: hidden;
}
.rdp-code-head {
  padding: 8px 16px; background: rgba(255,255,255,0.03); border-bottom: 1px solid rgba(255,255,255,0.1);
  display: flex; align-items: center; justify-content: space-between;
}
.rdp-code-lang { font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; color: #64748B; text-transform: uppercase; }
.rdp-code-body { padding: 1rem; overflow-x: auto; }
.rdp-code { font-family: 'JetBrains Mono', monospace; font-size: 0.9rem; color: #4ADE80; white-space: pre; }

/* ── TASK VISUALS ── */
.rdp-visual-card {
  margin: 32px 0;
  background: rgba(17, 24, 39, 0.4);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 28px;
  padding: 32px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
  position: relative;
  overflow: hidden;
}

.rdp-visual-img {
  max-width: 100%;
  height: auto;
  border-radius: 12px;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
}

.rdp-visual-caption {
  font-size: 0.75rem;
  font-weight: 800;
  color: #64748B;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  margin-top: 4px;
}

.rdp-flow {
  display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin: 2rem 0; padding: 1.5rem;
  background: rgba(255,255,255,0.02); border-radius: 16px; border: 1px solid rgba(255,255,255,0.05);
}
.rdp-flow-step {
  display: flex; align-items: center; gap: 10px; background: rgba(139, 92, 246, 0.1);
  padding: 10px 16px; border-radius: 12px; border: 1px solid rgba(139, 92, 246, 0.2);
  color: #fff; font-weight: 700; font-size: 0.9rem;
}
.rdp-flow-arrow { color: #64748B; opacity: 0.5; }

.rdp-tree {
  margin: 2rem 0; padding: 1.5rem; background: rgba(13, 18, 52, 0.3); border-radius: 16px;
  border: 1px dashed rgba(255,255,255,0.1);
}
.rdp-tree-node {
  display: flex; flex-direction: column; gap: 12px; position: relative; padding-left: 24px;
}
.rdp-tree-item {
  display: flex; align-items: center; gap: 10px; padding: 8px 14px;
  background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
  border-radius: 8px; width: fit-content; font-size: 0.85rem; font-weight: 600;
}
.rdp-tree-item::before {
  content: ''; position: absolute; left: 0; width: 14px; height: 1px;
  background: rgba(255,255,255,0.2); top: 50%;
}
.rdp-tree-children {
  border-left: 1px solid rgba(255,255,255,0.1); margin-left: 10px; padding-left: 20px;
  display: flex; flex-direction: column; gap: 8px;
}

.rdp-terminal {
  margin: 1.5rem 0; background: #010409; border: 1px solid #30363d; border-radius: 10px; overflow: hidden;
}
.rdp-terminal-head {
  padding: 8px 16px; background: #161b22; border-bottom: 1px solid #30363d;
  display: flex; align-items: center; justify-content: space-between;
}
.rdp-terminal-body { padding: 1.25rem; font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: #e6edf3; line-height: 1.5; }
.rdp-terminal-prompt { color: #238636; font-weight: bold; margin-right: 8px; }
.rdp-copy-btn {
  color: #8b949e; cursor: pointer; transition: 0.2s; background: none; border: none; padding: 4px; border-radius: 4px;
}
.rdp-copy-btn:hover { background: #30363d; color: #fff; }


.rdp-ans-section { margin-top: 2rem; padding: 1.5rem; background: rgba(255,255,255,0.03); border-radius: 14px; border: 1px solid rgba(255,255,255,0.06); }
.rdp-ans-lbl { font-size: 0.9rem; font-weight: 700; color: #fff; margin-bottom: 12px; display: block; }
.rdp-ans-row { display: flex; gap: 12px; }
.rdp-inp {
  flex: 1; min-width: 0; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1);
  border-radius: 10px; padding: 12px 16px; color: #fff; font-family: 'Inter', sans-serif;
  transition: 0.2s;
}
.rdp-inp:focus { border-color: #8B5CF6; outline: none; background: rgba(139, 92, 246, 0.05); }

.rdp-submit {
  padding: 0 1.5rem; border-radius: 10px; background: #8B5CF6; color: #fff; font-weight: 800;
  border: none; cursor: pointer; transition: 0.2s;
}
.rdp-submit:hover:not(:disabled) { transform: translateY(-2px); background: #7C3AED; }
.rdp-submit:disabled { opacity: 0.4; cursor: not-allowed; }

/* Right Info Sidebar */
.rdp-info { display: flex; flex-direction: column; gap: 1.5rem; position: sticky; top: 100px; height: fit-content; }
.rdp-info-sec { display: flex; flex-direction: column; gap: 10px; }
.rdp-info-lbl { font-size: 0.75rem; font-weight: 700; color: #64748B; text-transform: uppercase; letter-spacing: 0.05em; }
.rdp-info-box { padding: 1.25rem; border-radius: 16px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); }

/* Animation Classes */
@keyframes rdpFadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}
.rdp-fade-in { animation: rdpFadeIn 0.4s ease forwards; }

/* Responsive adjustments */
@media (max-width: 1200px) {
  .rdp-layout { grid-template-columns: 280px 1fr; }
  .rdp-info { display: none; }
}
@media (max-width: 900px) {
  .rdp-hero { grid-template-columns: 1fr; gap: 1.5rem; }
  .rdp-layout { grid-template-columns: 1fr; }
  .rdp-sidebar { position: static; height: auto; }
}

@media (max-width: 600px) {
  .rdp-wrap { padding: 1rem; }
  .rdp-hero { padding: 1.5rem; }
  .rdp-meta { flex-direction: column; align-items: flex-start; gap: 1rem; }
  .rdp-nav-content { flex-direction: column; align-items: flex-start; }
}

/* ── Room Completion Page (RCP) ── */
.rcp-root {
  background: #0B0F1A;
  color: #fff;
  position: relative;
  overflow-x: hidden;
  z-index: 1;
}

.rcp-grid-bg {
  position: fixed;
  inset: 0;
  background-image: 
    linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
  background-size: 50px 50px;
  pointer-events: none;
  z-index: -1;
}

.rcp-card {
  background: rgba(17, 24, 39, 0.7);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 24px;
  box-shadow: 0 20px 50px rgba(0,0,0,0.3);
}

.rcp-stat-box {
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.05);
  padding: 1.5rem;
  border-radius: 20px;
  display: flex;
  flex-direction: column;
}

.rcp-stat-lbl {
  font-size: 10px;
  font-weight: 800;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 0.5rem;
}

.rcp-stat-val {
  font-size: 1.5rem;
  font-weight: 900;
  letter-spacing: -0.02em;
}

.rcp-badge {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 1.25rem;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 16px;
  transition: all 0.3s ease;
}

.rcp-badge:hover {
  background: rgba(255,255,255,0.06);
  transform: translateY(-2px);
}

.rcp-badge--gold {
  background: rgba(250, 204, 21, 0.05);
  border-color: rgba(250, 204, 21, 0.2);
}

.rcp-primary-btn {
  background: #00F5FF;
  color: #000;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 1rem 2rem;
  border-radius: 16px;
  display: flex;
  align-items: center;
  transition: all 0.3s ease;
  box-shadow: 0 0 20px rgba(0, 245, 255, 0.2);
  border: none;
}

.rcp-primary-btn:hover {
  background: #fff;
  box-shadow: 0 0 30px rgba(0, 245, 255, 0.4);
  transform: scale(1.02);
}

.rcp-secondary-btn {
  background: rgba(255,255,255,0.05);
  color: #fff;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 1rem 2rem;
  border-radius: 16px;
  display: flex;
  align-items: center;
  border: 1px solid rgba(255,255,255,0.1);
  transition: all 0.3s ease;
}

.rcp-secondary-btn:hover {
  background: rgba(255,255,255,0.1);
  border-color: rgba(255,255,255,0.2);
}

.rcp-suggest-card {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1rem;
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 16px;
  transition: all 0.2s ease;
}

.rcp-suggest-card:hover {
  background: rgba(255,255,255,0.05);
  border-color: rgba(0, 245, 255, 0.2);
  transform: translateX(4px);
}

.rcp-icon-btn {
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 12px;
  transition: all 0.2s ease;
}

.rcp-icon-btn:hover {
  color: #fff;
  background: rgba(255,255,255,0.08);
  border-color: rgba(255,255,255,0.1);
}

.rcp-header {
  height: 70px;
}

.rcp-bounce {
  animation: rcp-bounce 2s infinite ease-in-out;
}

@keyframes rcp-bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

.rcp-fade-in {
  animation: rcp-fade 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes rcp-fade {
  from { opacity: 0; transform: translateY(30px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 768px) {
  .rcp-title { font-size: 3rem; }
  .rcp-stat-box { padding: 1.25rem; }
}

/* ── Leaderboard (LB) ── */
.lb-root {
  background: #0B0F1A;
  color: #fff;
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
}

.lb-grid {
  position: fixed;
  inset: 0;
  background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.05) 1px, transparent 0);
  background-size: 40px 40px;
  pointer-events: none;
  z-index: 0;
}

.lb-bg-glow {
  position: fixed;
  top: -10%; right: -10%;
  width: 60%; height: 60%;
  background: radial-gradient(circle, rgba(0, 245, 255, 0.05) 0%, transparent 70%);
  filter: blur(80px);
  pointer-events: none;
  z-index: 0;
}

.lb-title-wrap {
  text-align: center;
  margin-bottom: 4rem;
  position: relative;
  z-index: 1;
}

.lb-title-main {
  font-size: 4rem;
  font-weight: 900;
  font-style: italic;
  letter-spacing: -0.05em;
  background: linear-gradient(to bottom, #fff 30%, rgba(255,255,255,0.5));
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  text-transform: uppercase;
}

.lb-podium {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 1.5rem;
  margin-bottom: 5rem;
  position: relative;
  z-index: 2;
}

.lb-pod-item {
  flex: 1;
  max-width: 320px;
  background: rgba(17, 24, 39, 0.6);
  backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 24px;
  padding: 2rem;
  text-align: center;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
}

.lb-pod-item:hover {
  transform: translateY(-8px);
  background: rgba(17, 24, 39, 0.8);
  border-color: rgba(255,255,255,0.1);
}

.lb-pod-item--1 {
  height: 480px;
  border-color: rgba(250, 204, 21, 0.2);
  box-shadow: 0 0 40px rgba(250, 204, 21, 0.05);
  order: 2;
}

.lb-pod-item--2 { height: 400px; order: 1; }
.lb-pod-item--3 { height: 380px; order: 3; }

.lb-avatar-ring {
  width: 100px; height: 100px;
  border-radius: 50%;
  margin: 0 auto 1.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 4px;
  background: rgba(255,255,255,0.05);
}

.lb-pod-item--1 .lb-avatar-ring { 
  background: linear-gradient(135deg, #FACC15, #EAB308);
  box-shadow: 0 0 20px rgba(234, 179, 8, 0.3);
}

.lb-rank-badge {
  position: absolute;
  bottom: -10px;
  left: 50%;
  transform: translateX(-50%);
  width: 32px; height: 32px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  font-size: 14px;
  color: #000;
  border: 4px solid #111827;
}

.lb-pod-item--1 .lb-rank-badge { background: #FACC15; }
.lb-pod-item--2 .lb-rank-badge { background: #CBD5E1; }
.lb-pod-item--3 .lb-rank-badge { background: #B45309; }

.lb-list-wrap {
  position: relative;
  z-index: 1;
}

.lb-row {
  background: rgba(17, 24, 39, 0.4);
  border: 1px solid rgba(255,255,255,0.03);
  margin-bottom: 0.75rem;
  border-radius: 16px;
  transition: all 0.2s ease;
  display: grid;
  grid-template-columns: 80px 1fr 120px 160px;
  align-items: center;
  padding: 1rem 1.5rem;
}

.lb-row:hover {
  background: rgba(17, 24, 39, 0.6);
  border-color: rgba(255,255,255,0.08);
  transform: translateX(4px);
}

.lb-row--user {
  background: rgba(0, 245, 255, 0.05);
  border-color: rgba(0, 245, 255, 0.2);
}

.lb-rank-num {
  font-size: 1.5rem;
  font-weight: 900;
  color: #64748B;
  font-family: 'Orbitron', sans-serif;
}

.lb-row--user .lb-rank-num { color: #00F5FF; }

.lb-user-info {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.lb-user-avatar {
  width: 44px; height: 44px;
  border-radius: 12px;
  background: rgba(255,255,255,0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  color: #fff;
  border: 1px solid rgba(255,255,255,0.05);
}

.lb-xp-pill {
  background: rgba(0, 245, 255, 0.1);
  color: #00F5FF;
  padding: 4px 12px;
  border-radius: 8px;
  font-weight: 800;
  font-size: 13px;
  text-align: right;
}

.lb-status-footer {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  padding: 1.5rem 2rem;
  background: rgba(11, 15, 26, 0.9);
  backdrop-filter: blur(20px);
  border-top: 1px solid rgba(0, 245, 255, 0.2);
  z-index: 100;
  box-shadow: 0 -20px 40px rgba(0,0,0,0.4);
}

.lb-tab-btn {
  padding: 0.75rem 1.5rem;
  border-radius: 12px;
  font-weight: 800;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  transition: all 0.2s ease;
  border: 1px solid transparent;
  color: #64748B;
}

.lb-tab-btn--active {
  background: rgba(0, 245, 255, 0.1);
  color: #00F5FF;
  border-color: rgba(0, 245, 255, 0.2);
}

.lb-tab-btn:hover:not(.lb-tab-btn--active) {
  background: rgba(255,255,255,0.03);
  color: #fff;
}

@media (max-width: 1024px) {
  .lb-podium { flex-direction: column; align-items: center; }
  .lb-pod-item { width: 100%; height: auto !important; order: unset !important; }
}

@media (max-width: 768px) {
  .lb-row { grid-template-columns: 60px 1fr 100px; }
  .lb-row > :nth-child(4) { display: none; }
  .lb-title-main { font-size: 2.5rem; }
}

/* ── Premium Page (PP) ── */
.pp-root {
  background: #0B0F1A;
  color: #fff;
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
}

.pp-grid {
  position: fixed;
  inset: 0;
  background-image: 
    linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
  background-size: 60px 60px;
  pointer-events: none;
  z-index: 0;
}

.pp-glow {
  position: fixed;
  top: 0; left: 50%;
  transform: translateX(-50%);
  width: 1000px; height: 600px;
  background: radial-gradient(circle, rgba(0, 245, 255, 0.05) 0%, transparent 70%);
  filter: blur(100px);
  pointer-events: none;
  z-index: 0;
}

.pp-hero {
  text-align: center;
  padding: 6rem 1rem 4rem;
  position: relative;
  z-index: 1;
}

.pp-tag {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1.25rem;
  background: rgba(0, 245, 255, 0.05);
  border: 1px solid rgba(0, 245, 255, 0.2);
  border-radius: 100px;
  color: #00F5FF;
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 2rem;
}

.pp-title {
  font-size: clamp(3rem, 8vw, 5rem);
  font-weight: 900;
  letter-spacing: -0.04em;
  margin-bottom: 1.5rem;
  line-height: 1;
}

.pp-card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 2rem;
  margin-bottom: 6rem;
  position: relative;
  z-index: 1;
}

.pp-card {
  background: rgba(17, 24, 39, 0.6);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 32px;
  padding: 3rem 2.5rem;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column;
}

.pp-card:hover {
  background: rgba(17, 24, 39, 0.8);
  border-color: rgba(255,255,255,0.1);
  transform: translateY(-8px);
}

.pp-card--premium {
  border-color: rgba(0, 245, 255, 0.3);
  box-shadow: 0 0 40px rgba(0, 245, 255, 0.05);
  position: relative;
}

.pp-card--premium::after {
  content: '';
  position: absolute;
  inset: -1px;
  border-radius: 32px;
  padding: 1px;
  background: linear-gradient(135deg, rgba(0, 245, 255, 0.4), transparent, rgba(139, 92, 246, 0.4));
  mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}

.pp-price-wrap {
  margin-bottom: 2.5rem;
}

.pp-price {
  font-size: 3.5rem;
  font-weight: 900;
  display: flex;
  align-items: baseline;
  gap: 0.25rem;
}

.pp-period {
  font-size: 1rem;
  color: #64748B;
  font-weight: 600;
}

.pp-feat-list {
  list-style: none;
  padding: 0;
  margin: 0 0 3rem;
  flex: 1;
}

.pp-feat-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 1rem;
  font-size: 14px;
  color: #94A3B8;
}

.pp-feat-item--inc {
  color: #fff;
  font-weight: 600;
}

.pp-table-wrap {
  background: rgba(17, 24, 39, 0.4);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 24px;
  overflow: hidden;
  margin-bottom: 6rem;
  position: relative;
  z-index: 1;
}

.pp-table {
  width: 100%;
  border-collapse: collapse;
}

.pp-table th {
  text-align: left;
  padding: 1.5rem 2rem;
  background: rgba(255,255,255,0.02);
  font-size: 12px;
  font-weight: 800;
  text-transform: uppercase;
  color: #64748B;
  border-bottom: 1px solid rgba(255,255,255,0.05);
}

.pp-table td {
  padding: 1.5rem 2rem;
  border-bottom: 1px solid rgba(255,255,255,0.03);
  font-size: 14px;
}

.pp-table tr:last-child td { border-bottom: none; }

.pp-faq-item {
  background: rgba(17, 24, 39, 0.4);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 16px;
  margin-bottom: 1rem;
  overflow: hidden;
}

.pp-faq-trigger {
  width: 100%;
  padding: 1.5rem 2rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  text-align: left;
  font-weight: 700;
  transition: all 0.2s ease;
}

.pp-faq-trigger:hover {
  background: rgba(255,255,255,0.02);
}

.pp-faq-content {
  padding: 0 2rem 1.5rem;
  color: #94A3B8;
  font-size: 15px;
  line-height: 1.6;
}

.pp-btn-toggle {
  display: flex;
  background: rgba(17, 24, 39, 0.8);
  border: 1px solid rgba(255,255,255,0.1);
  padding: 4px;
  border-radius: 16px;
  width: fit-content;
  margin: 0 auto 3rem;
}

.pp-toggle-opt {
  padding: 0.75rem 1.75rem;
  border-radius: 12px;
  font-size: 13px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  transition: all 0.2s ease;
  color: #64748B;
}

.pp-toggle-opt--active {
  background: #00F5FF;
  color: #000;
  box-shadow: 0 0 20px rgba(0, 245, 255, 0.3);
}

.pp-cta-box {
  background: linear-gradient(135deg, rgba(0, 245, 255, 0.1), rgba(139, 92, 246, 0.1));
  border: 1px solid rgba(0, 245, 255, 0.2);
  border-radius: 32px;
  padding: 5rem 2rem;
  text-align: center;
  position: relative;
  z-index: 1;
}

@media (max-width: 768px) {
  .pp-title { font-size: 3rem; }
  .pp-card { padding: 2rem 1.5rem; }
  .pp-table-wrap { overflow-x: auto; }
  .pp-table { min-width: 600px; }
}

/* ── Certificate Page (CP) ── */
.cp-root {
  background: #0B0F1A;
  color: #fff;
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
}

.cp-grid {
  position: fixed;
  inset: 0;
  background-image: 
    linear-gradient(rgba(0, 245, 255, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0, 245, 255, 0.03) 1px, transparent 1px);
  background-size: 40px 40px;
  pointer-events: none;
  z-index: 0;
}

.cp-bg-glow {
  position: fixed;
  top: 0; right: 0;
  width: 600px; height: 600px;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.05) 0%, transparent 70%);
  filter: blur(80px);
  pointer-events: none;
  z-index: 0;
}

.cp-hero {
  text-align: center;
  padding: 6rem 1rem 4rem;
  position: relative;
  z-index: 1;
}

.cp-stat-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1.5rem;
  margin-bottom: 4rem;
  position: relative;
  z-index: 1;
}

.cp-stat-card {
  background: rgba(17, 24, 39, 0.6);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 20px;
  padding: 1.5rem;
  display: flex;
  align-items: center;
  gap: 1.25rem;
  transition: all 0.3s ease;
}

.cp-stat-card:hover {
  border-color: rgba(0, 245, 255, 0.2);
  transform: translateY(-4px);
  background: rgba(17, 24, 39, 0.8);
}

.cp-stat-icon {
  width: 48px; height: 48px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.03);
  color: #64748B;
}

.cp-stat-val {
  font-size: 1.75rem;
  font-weight: 900;
  line-height: 1;
  color: #fff;
}

.cp-stat-label {
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  color: #64748B;
  letter-spacing: 0.1em;
}

.cp-cert-card {
  background: rgba(17, 24, 39, 0.4);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 24px;
  overflow: hidden;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
}

.cp-cert-card:hover {
  transform: translateY(-8px) scale(1.02);
  border-color: rgba(0, 245, 255, 0.3);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
}

.cp-cert-preview {
  aspect-ratio: 16/10.5;
  background: #0f172a;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding: 2rem;
}

.cp-cert-preview--locked {
  filter: grayscale(1) brightness(0.5);
}

.cp-cert-border {
  position: absolute;
  inset: 12px;
  border: 1px solid rgba(0, 245, 255, 0.15);
  pointer-events: none;
}

.cp-cert-seal {
  position: absolute;
  bottom: 1.5rem;
  right: 1.5rem;
  width: 60px; height: 60px;
  background: radial-gradient(circle, rgba(0, 245, 255, 0.2) 0%, transparent 70%);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 100%;
}

.cp-cert-title {
  font-size: 1.25rem;
  font-weight: 800;
  color: #fff;
  margin-top: 1rem;
  line-height: 1.3;
}

.cp-cert-meta {
  font-size: 10px;
  font-weight: 700;
  color: #64748B;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.cp-cert-score {
  display: inline-flex;
  padding: 0.25rem 0.75rem;
  background: rgba(57, 255, 20, 0.1);
  border: 1px solid rgba(57, 255, 20, 0.2);
  border-radius: 100px;
  color: #39FF14;
  font-size: 11px;
  font-weight: 800;
  margin-top: auto;
}

.cp-cert-actions {
  padding: 1.5rem;
  background: rgba(255,255,255,0.02);
  border-top: 1px solid rgba(255,255,255,0.05);
}

.cp-linkedin-btn {
  width: 100%;
  background: #0077B5;
  color: #fff;
  border: none;
  padding: 0.875rem;
  border-radius: 12px;
  font-weight: 800;
  font-size: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  transition: all 0.2s ease;
  margin-bottom: 0.75rem;
}

.cp-linkedin-btn:hover {
  background: #006399;
  transform: scale(0.98);
}

.cp-download-btn {
  width: 100%;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  color: #fff;
  padding: 0.875rem;
  border-radius: 12px;
  font-weight: 700;
  font-size: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  transition: all 0.2s ease;
}

.cp-download-btn:hover {
  background: rgba(255,255,255,0.1);
  border-color: rgba(255,255,255,0.2);
}

.cp-nav-pills {
  display: flex;
  background: rgba(17, 24, 39, 0.8);
  border: 1px solid rgba(255,255,255,0.1);
  padding: 4px;
  border-radius: 14px;
  width: fit-content;
}

.cp-nav-pill {
  padding: 0.6rem 1.5rem;
  border-radius: 10px;
  font-size: 12px;
  font-weight: 800;
  color: #64748B;
  transition: all 0.2s ease;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.cp-nav-pill--active {
  background: #00F5FF;
  color: #000;
  box-shadow: 0 0 15px rgba(0, 245, 255, 0.3);
}

.cp-overlay {
  position: absolute;
  inset: 0;
  background: rgba(11, 15, 26, 0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
  z-index: 10;
  padding: 2rem;
  text-align: center;
}

.cp-cert-card:hover .cp-overlay {
  opacity: 1;
}

@media (max-width: 768px) {
  .cp-hero { padding: 4rem 1rem 2rem; }
  .cp-stat-grid { grid-template-columns: repeat(2, 1fr); }
  .cp-nav-pills { width: 100%; justify-content: space-around; }
}

/* ── User Profile (UP) ── */
.up-root {
  background: #0B0F1A;
  color: #fff;
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
}

.up-grid {
  position: fixed;
  inset: 0;
  background-image: 
    radial-gradient(circle at 2px 2px, rgba(255,255,255,0.02) 1px, transparent 0);
  background-size: 32px 32px;
  pointer-events: none;
  z-index: 0;
}

.up-bg-glow {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: 
    radial-gradient(circle at 10% 20%, rgba(0, 245, 255, 0.03) 0%, transparent 50%),
    radial-gradient(circle at 90% 80%, rgba(139, 92, 246, 0.03) 0%, transparent 50%);
  pointer-events: none;
  z-index: 0;
}

.up-identity-card {
  background: rgba(17, 24, 39, 0.4);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 32px;
  padding: 3rem 2rem;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.up-identity-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 4px;
  background: linear-gradient(90deg, #00F5FF, #8B5CF6, #00F5FF);
  background-size: 200% 100%;
  animation: lb-gradient-flow 3s linear infinite;
}

.up-avatar-wrap {
  position: relative;
  width: 160px; height: 160px;
  margin: 0 auto 1.5rem;
}

.up-avatar-ring {
  position: absolute;
  inset: -8px;
  border: 2px solid rgba(0, 245, 255, 0.2);
  border-radius: 100%;
  animation: up-spin 10s linear infinite;
}

.up-avatar-ring::after {
  content: '';
  position: absolute;
  top: -4px; left: 50%;
  width: 8px; height: 8px;
  background: #00F5FF;
  border-radius: 100%;
  box-shadow: 0 0 15px #00F5FF;
}

.up-avatar-img {
  width: 100%; height: 100%;
  border-radius: 100%;
  object-fit: cover;
  border: 4px solid #111827;
  position: relative;
  z-index: 1;
}

.up-rank-tag {
  display: inline-flex;
  padding: 0.35rem 1rem;
  background: rgba(155, 255, 0, 0.1);
  border: 1px solid rgba(155, 255, 0, 0.2);
  border-radius: 100px;
  color: #FACC15;
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-top: 1rem;
}

.up-stat-tile {
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 20px;
  padding: 1.5rem;
  text-align: center;
  transition: all 0.3s ease;
}

.up-stat-tile:hover {
  background: rgba(255,255,255,0.05);
  border-color: rgba(0, 245, 255, 0.2);
  transform: translateY(-4px);
}

.up-stat-val {
  font-size: 1.75rem;
  font-weight: 900;
  color: #fff;
  line-height: 1;
  margin-bottom: 0.25rem;
}

.up-stat-label {
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  color: #64748B;
  letter-spacing: 0.1em;
}

.up-section-title {
  font-size: 1.25rem;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: -0.02em;
  margin-bottom: 1.5rem;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  color: #fff;
}

.up-matrix-card {
  background: rgba(17, 24, 39, 0.4);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 24px;
  padding: 2rem;
}

.up-heatmap-grid {
  display: flex;
  gap: 3px;
  overflow-x: auto;
  padding-bottom: 1rem;
}

.up-heatmap-day {
  width: 10px; height: 10px;
  border-radius: 2px;
  background: rgba(255,255,255,0.05);
  transition: all 0.2s ease;
}

.up-heatmap-day--1 { background: rgba(0, 245, 255, 0.2); }
.up-heatmap-day--2 { background: rgba(0, 245, 255, 0.4); }
.up-heatmap-day--3 { background: rgba(0, 245, 255, 0.6); }
.up-heatmap-day--4 { background: rgba(0, 245, 255, 0.8); box-shadow: 0 0 10px rgba(0, 245, 255, 0.3); }

.up-badge-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  gap: 1rem;
}

.up-badge-item {
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 16px;
  padding: 1.5rem 1rem;
  text-align: center;
  transition: all 0.3s ease;
}

.up-badge-item:hover {
  background: rgba(255,255,255,0.04);
  border-color: rgba(139, 92, 246, 0.3);
  transform: scale(1.05);
}

.up-badge-icon {
  font-size: 2rem;
  margin-bottom: 0.75rem;
  display: block;
}

.up-activity-row {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  padding: 1.25rem;
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 16px;
  margin-bottom: 0.75rem;
  transition: all 0.2s ease;
}

.up-activity-row:hover {
  background: rgba(255,255,255,0.04);
  border-color: rgba(255,255,255,0.1);
}

.up-activity-icon {
  width: 44px; height: 44px;
  background: rgba(0, 245, 255, 0.05);
  border: 1px solid rgba(0, 245, 255, 0.1);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #00F5FF;
}

@keyframes up-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@media (max-width: 1024px) {
  .up-identity-card { margin-bottom: 2rem; }
}

@media (max-width: 768px) {
  .up-avatar-wrap { width: 120px; height: 120px; }
  .up-stat-tile { padding: 1rem; }
  .up-stat-val { font-size: 1.25rem; }
}

/* ── Manage Settings (MS) ── */
.ms-root {
  background: #0B0F1A;
  color: #fff;
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
}

.ms-grid {
  position: fixed;
  inset: 0;
  background-image: 
    linear-gradient(rgba(0, 245, 255, 0.02) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0, 245, 255, 0.02) 1px, transparent 1px);
  background-size: 50px 50px;
  pointer-events: none;
  z-index: 0;
}

.ms-header {
  margin-bottom: 3rem;
  position: relative;
  z-index: 1;
}

.ms-title {
  font-size: 2.5rem;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: -0.05em;
  font-style: italic;
  margin-bottom: 0.5rem;
}

.ms-subtitle {
  color: #64748B;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  font-size: 10px;
}

.ms-nav-card {
  background: rgba(17, 24, 39, 0.6);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 20px;
  padding: 1rem;
}

.ms-nav-btn {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1rem 1.25rem;
  border-radius: 12px;
  font-size: 13px;
  font-weight: 800;
  color: #64748B;
  transition: all 0.2s ease;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border: 1px solid transparent;
}

.ms-nav-btn:hover {
  background: rgba(255,255,255,0.03);
  color: #fff;
}

.ms-nav-btn--active {
  background: rgba(0, 245, 255, 0.05);
  border-color: rgba(0, 245, 255, 0.2);
  color: #00F5FF;
  box-shadow: 0 0 15px rgba(0, 245, 255, 0.1);
}

.ms-content-card {
  background: rgba(17, 24, 39, 0.4);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 24px;
  padding: 2.5rem;
  position: relative;
  overflow: hidden;
}

.ms-tab-title {
  font-size: 1.5rem;
  font-weight: 900;
  text-transform: uppercase;
  margin-bottom: 2rem;
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.ms-biometric-wrap {
  display: flex;
  align-items: center;
  gap: 2rem;
  padding-bottom: 2rem;
  margin-bottom: 2rem;
  border-bottom: 1px solid rgba(255,255,255,0.05);
}

.ms-avatar-container {
  width: 100px; height: 100px;
  position: relative;
}

.ms-avatar-img {
  width: 100%; height: 100%;
  border-radius: 20px;
  object-fit: cover;
  border: 2px solid rgba(0, 245, 255, 0.2);
}

.ms-avatar-overlay {
  position: absolute;
  inset: 0;
  background: rgba(11, 15, 26, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20px;
  opacity: 0;
  transition: opacity 0.2s ease;
  cursor: pointer;
}

.ms-avatar-container:hover .ms-avatar-overlay {
  opacity: 1;
}

.ms-input-group {
  margin-bottom: 1.5rem;
}

.ms-label {
  display: block;
  font-size: 10px;
  font-weight: 900;
  text-transform: uppercase;
  color: #64748B;
  letter-spacing: 0.1em;
  margin-bottom: 0.75rem;
}

.ms-input {
  width: 100%;
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: 12px;
  padding: 0.875rem 1.25rem;
  color: #fff;
  font-weight: 600;
  font-size: 14px;
  transition: all 0.2s ease;
}

.ms-input:focus {
  background: rgba(255,255,255,0.05);
  border-color: rgba(0, 245, 255, 0.4);
  outline: none;
  box-shadow: 0 0 15px rgba(0, 245, 255, 0.1);
}

.ms-danger-zone {
  margin-top: 4rem;
  padding: 2rem;
  border-radius: 20px;
  background: rgba(255, 61, 113, 0.03);
  border: 1px solid rgba(255, 61, 113, 0.15);
}

.ms-danger-title {
  color: #FF3D71;
  font-size: 14px;
  font-weight: 900;
  text-transform: uppercase;
  margin-bottom: 0.5rem;
}

.ms-danger-btn {
  background: rgba(255, 61, 113, 0.1);
  color: #FF3D71;
  border: 1px solid rgba(255, 61, 113, 0.2);
  padding: 0.75rem 1.5rem;
  border-radius: 10px;
  font-weight: 800;
  font-size: 12px;
  text-transform: uppercase;
  transition: all 0.2s ease;
  margin-top: 1rem;
}

.ms-danger-btn:hover {
  background: #FF3D71;
  color: #fff;
}

.ms-toast {
  position: fixed;
  bottom: 2rem; right: 2rem;
  background: rgba(17, 24, 39, 0.9);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(0, 245, 255, 0.3);
  padding: 1rem 1.5rem;
  border-radius: 12px;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  z-index: 1000;
  animation: slideIn 0.3s ease;
}

@keyframes slideIn {
  from { transform: translateX(100%); opacity: 0; }
  to { transform: translateX(0); opacity: 1; }
}

@media (max-width: 1024px) {
  .ms-nav-card { margin-bottom: 1.5rem; }
}

@media (max-width: 768px) {
  .ms-content-card { padding: 1.5rem; }
  .ms-biometric-wrap { flex-direction: column; text-align: center; align-items: center; }
}

/* ── Saved Items / Tactical Archive (SI) ── */
.si-root {
  background: #0B0F1A;
  color: #fff;
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
}

.si-grid-bg {
  position: fixed;
  inset: 0;
  background-image: 
    linear-gradient(to right, rgba(139, 92, 246, 0.03) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(139, 92, 246, 0.03) 1px, transparent 1px);
  background-size: 40px 40px;
  pointer-events: none;
  z-index: 0;
}

.si-hero {
  margin-bottom: 4rem;
  text-align: left;
}

.si-title {
  font-size: clamp(3rem, 8vw, 4.5rem);
  font-weight: 950;
  text-transform: uppercase;
  letter-spacing: -0.05em;
  line-height: 0.9;
  margin-bottom: 1rem;
}

.si-subtitle {
  color: #64748B;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.3em;
  font-size: 11px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.si-empty-state {
  text-align: center;
  padding: 8rem 2rem;
  background: rgba(139, 92, 246, 0.03);
  border: 1px dashed rgba(139, 92, 246, 0.2);
  border-radius: 40px;
  margin-top: 2rem;
}

.si-empty-icon {
  width: 80px;
  height: 80px;
  margin-bottom: 2rem;
  color: #8B5CF6;
}

.si-card {
  background: rgba(17, 24, 39, 0.4);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 32px;
  padding: 2.5rem;
  position: relative;
  transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  display: flex;
  flex-direction: column;
  height: 100%;
}

.si-card:hover {
  transform: translateY(-10px);
  border-color: rgba(139, 92, 246, 0.3);
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 20px rgba(139, 92, 246, 0.1);
}

.si-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; height: 100px;
  background: linear-gradient(180deg, rgba(139, 92, 246, 0.05) 0%, transparent 100%);
  pointer-events: none;
  border-radius: 32px 32px 0 0;
}

.si-unsave-btn {
  position: absolute;
  top: 1.5rem;
  right: 1.5rem;
  width: 36px;
  height: 36px;
  border-radius: 12px;
  background: rgba(255, 61, 113, 0.1);
  border: 1px solid rgba(255, 61, 113, 0.2);
  color: #FF3D71;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s;
  z-index: 5;
}

.si-unsave-btn:hover {
  background: #FF3D71;
  color: #fff;
  transform: scale(1.1);
}

.si-type-tag {
  display: inline-flex;
  align-items: center;
  padding: 6px 14px;
  border-radius: 99px;
  font-size: 10px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 2rem;
}

.si-type-tag--room {
  background: rgba(139, 92, 246, 0.1);
  color: #8B5CF6;
  border: 1px solid rgba(139, 92, 246, 0.2);
}

.si-type-tag--lab {
  background: rgba(0, 245, 255, 0.1);
  color: #00F5FF;
  border: 1px solid rgba(0, 245, 255, 0.2);
}

.si-item-icon {
  font-size: 3rem;
  margin-bottom: 1.5rem;
  filter: drop-shadow(0 0 10px rgba(139, 92, 246, 0.3));
}

.si-item-title {
  font-size: 1.5rem;
  font-weight: 800;
  line-height: 1.2;
  margin-bottom: 1rem;
  color: #fff;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.si-item-meta {
  color: #94A3B8;
  font-size: 0.85rem;
  font-weight: 600;
  margin-bottom: 2rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.si-stat-row {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  margin-top: auto;
  margin-bottom: 2rem;
  padding-top: 1.5rem;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
}

.si-stat {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.75rem;
  font-weight: 700;
  color: #64748B;
}

/* Animations from RDP namespace but useful here */
.rcp-fade-in {
  animation: rcpFadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes rcpFadeIn {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

.gradient-text {
  background: linear-gradient(135deg, #8B5CF6, #00F5FF);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* ── Checkout Page (CH) ── */
.ch-root {
  background: #0B0F1A;
  color: #fff;
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
}

.ch-grid-bg {
  position: fixed;
  inset: 0;
  background-image: 
    linear-gradient(rgba(0, 245, 255, 0.02) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0, 245, 255, 0.02) 1px, transparent 1px);
  background-size: 50px 50px;
  pointer-events: none;
  z-index: 0;
}

.ch-glow {
  position: fixed;
  top: -10%; left: 50%;
  transform: translateX(-50%);
  width: 1000px; height: 600px;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.04) 0%, transparent 70%);
  filter: blur(100px);
  pointer-events: none;
  z-index: 0;
}

.ch-container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 4rem 1.5rem;
  position: relative;
  z-index: 1;
}

.ch-header {
  margin-bottom: 3.5rem;
}

.ch-title {
  font-size: 3rem;
  font-weight: 950;
  text-transform: uppercase;
  letter-spacing: -0.05em;
  font-style: italic;
  margin-bottom: 0.5rem;
  line-height: 1;
}

.ch-subtitle {
  color: #64748B;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.25em;
  font-size: 10px;
}

.ch-main-grid {
  display: grid;
  grid-template-columns: 1fr 380px;
  gap: 2.5rem;
  align-items: start;
}

.ch-card {
  background: rgba(17, 24, 39, 0.45);
  backdrop-filter: blur(24px);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 28px;
  padding: 2.5rem;
  margin-bottom: 2rem;
}

.ch-section-title {
  font-size: 1.25rem;
  font-weight: 950;
  text-transform: uppercase;
  font-style: italic;
  margin-bottom: 2rem;
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.ch-section-title span {
  color: #64748B;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
  font-style: normal;
  margin-left: auto;
}

.ch-method-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
  margin-bottom: 2.5rem;
}

.ch-method-opt {
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 18px;
  padding: 1.25rem;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  align-items: center;
  gap: 1rem;
}

.ch-method-opt:hover {
  background: rgba(255,255,255,0.05);
  border-color: rgba(255,255,255,0.15);
  transform: translateY(-2px);
}

.ch-method-opt--active {
  background: rgba(0, 245, 255, 0.05);
  border-color: rgba(0, 245, 255, 0.3);
  box-shadow: 0 0 15px rgba(0, 245, 255, 0.1);
}

.ch-method-icon {
  width: 44px; height: 44px;
  background: rgba(255,255,255,0.03);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748B;
  transition: all 0.2s ease;
}

.ch-method-opt--active .ch-method-icon {
  background: rgba(0, 245, 255, 0.15);
  color: #00F5FF;
}

.ch-method-name {
  font-size: 13px;
  font-weight: 900;
  text-transform: uppercase;
  color: #64748B;
  transition: color 0.2s ease;
}

.ch-method-opt--active .ch-method-name {
  color: #fff;
}

/* ── Form Inputs ── */
.ch-form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25rem;
  margin-bottom: 1.25rem;
}

.ch-input-wrap {
  margin-bottom: 1.5rem;
}

.ch-label {
  display: block;
  font-size: 10px;
  font-weight: 900;
  text-transform: uppercase;
  color: #64748B;
  letter-spacing: 0.15em;
  margin-bottom: 0.75rem;
}

.ch-input {
  width: 100%;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 14px;
  padding: 1rem 1.25rem;
  color: #fff;
  font-weight: 600;
  font-size: 14px;
  transition: all 0.2s ease;
}

.ch-input:focus {
  background: rgba(255,255,255,0.05);
  border-color: rgba(0, 245, 255, 0.4);
  outline: none;
  box-shadow: 0 0 15px rgba(0, 245, 255, 0.1);
}

.ch-input::placeholder {
  color: #1E293B;
}

/* ── Order Summary ── */
.ch-summary-card {
  background: rgba(17, 24, 39, 0.6);
  backdrop-filter: blur(24px);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 28px;
  padding: 2rem;
  position: sticky;
  top: 7rem;
}

.ch-plan-preview {
  background: linear-gradient(135deg, rgba(0, 245, 255, 0.1), rgba(139, 92, 246, 0.1));
  border: 1px solid rgba(0, 245, 255, 0.2);
  border-radius: 20px;
  padding: 1.5rem;
  margin-bottom: 2rem;
}

.ch-preview-tag {
  font-size: 9px;
  font-weight: 900;
  text-transform: uppercase;
  color: #00F5FF;
  letter-spacing: 0.1em;
  margin-bottom: 0.5rem;
}

.ch-preview-name {
  font-size: 1.5rem;
  font-weight: 950;
  text-transform: uppercase;
  font-style: italic;
  line-height: 1;
  margin-bottom: 1rem;
}

.ch-summary-line {
  display: flex;
  justify-content: space-between;
  margin-bottom: 0.75rem;
  font-size: 13px;
  font-weight: 700;
  color: #64748B;
  text-transform: uppercase;
}

.ch-summary-line--total {
  margin-top: 1.5rem;
  padding-top: 1.5rem;
  border-top: 1px solid rgba(255,255,255,0.05);
  font-size: 1.25rem;
  font-weight: 950;
  color: #fff;
}

.ch-summary-line--total span {
  color: #00F5FF;
}

.ch-trust-badge {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-top: 2rem;
  padding: 1.25rem;
  background: rgba(15, 23, 42, 0.4);
  border-radius: 16px;
  border: 1px solid rgba(255,255,255,0.03);
}

.ch-trust-text {
  font-size: 10px;
  font-weight: 700;
  color: #64748B;
  line-height: 1.4;
  text-transform: uppercase;
}

@media (max-width: 1024px) {
  .ch-main-grid { grid-template-columns: 1fr; }
  .ch-summary-card { position: static; }
}

@media (max-width: 768px) {
  .ch-method-grid { grid-template-columns: 1fr; }
  .ch-form-row { grid-template-columns: 1fr; }
  .ch-title { font-size: 2.25rem; }
}

/* ── Badges Gallery (BG) ── */
.bg-root {
  background: #0B0F1A;
  color: #fff;
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
}

.bg-grid-overlay {
  position: fixed;
  inset: 0;
  background-image: 
    radial-gradient(circle at 1px 1px, rgba(255,255,255,0.03) 1px, transparent 0);
  background-size: 24px 24px;
  pointer-events: none;
  z-index: 0;
}

.bg-hero {
  padding-top: 5rem;
  margin-bottom: 5rem;
  position: relative;
  z-index: 1;
}

.bg-title {
  font-size: 4rem;
  font-weight: 1000;
  text-transform: uppercase;
  letter-spacing: -0.06em;
  font-style: italic;
  line-height: 0.85;
  margin-bottom: 0.5rem;
}

.bg-subtitle {
  color: #64748B;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.4em;
  font-size: 11px;
}

.bg-stat-banner {
  background: rgba(17, 24, 39, 0.4);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 20px;
  padding: 1.5rem 2rem;
  display: flex;
  align-items: center;
  gap: 3rem;
  margin-bottom: 4rem;
  position: relative;
}

.bg-stat-banner::after {
  content: '';
  position: absolute;
  top: 50%; right: 2rem;
  transform: translateY(-50%);
  width: 40px; height: 1px;
  background: rgba(0, 245, 255, 0.2);
}

.bg-stat-item {
  display: flex;
  flex-direction: column;
}

.bg-stat-val {
  font-size: 1.5rem;
  font-weight: 900;
  color: #00F5FF;
  line-height: 1;
}

.bg-stat-label {
  font-size: 9px;
  font-weight: 800;
  text-transform: uppercase;
  color: #64748B;
  letter-spacing: 0.1em;
  margin-top: 0.25rem;
}

.bg-badge-card {
  background: rgba(17, 24, 39, 0.4);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 32px;
  padding: 2.5rem 2rem;
  text-align: center;
  position: relative;
  transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  overflow: hidden;
}

.bg-badge-card:hover {
  transform: translateY(-12px) scale(1.02);
  background: rgba(17, 24, 39, 0.6);
  border-color: rgba(0, 245, 255, 0.3);
  box-shadow: 0 30px 60px rgba(0,0,0,0.5);
}

.bg-badge-pedestal {
  width: 100px; height: 100px;
  margin: 0 auto 1.5rem;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bg-pedestal-glow {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle, rgba(0, 245, 255, 0.15) 0%, transparent 70%);
  border-radius: 100%;
  animation: bg-pulse 3s ease-in-out infinite;
}

.bg-badge-icon {
  font-size: 3rem;
  position: relative;
  z-index: 1;
  filter: drop-shadow(0 0 15px rgba(255,255,255,0.2));
}

.bg-badge-name {
  font-size: 1.125rem;
  font-weight: 900;
  text-transform: uppercase;
  font-style: italic;
  color: #fff;
  margin-bottom: 0.5rem;
  letter-spacing: -0.02em;
}

.bg-badge-desc {
  font-size: 12px;
  color: #64748B;
  font-weight: 600;
  line-height: 1.5;
  margin-bottom: 1.5rem;
  height: 36px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.bg-badge-date {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.35rem 0.75rem;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 100px;
  font-size: 9px;
  font-weight: 800;
  color: #64748B;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.bg-empty-state {
  text-align: center;
  padding: 10rem 2rem;
  background: rgba(17, 24, 39, 0.4);
  backdrop-filter: blur(20px);
  border: 2px dashed rgba(255,255,255,0.05);
  border-radius: 40px;
}

@keyframes bg-pulse {
  0% { transform: scale(1); opacity: 0.5; }
  50% { transform: scale(1.2); opacity: 0.8; }
  100% { transform: scale(1); opacity: 0.5; }
}

@media (max-width: 1024px) {
  .bg-title { font-size: 3rem; }
  .bg-stat-banner { gap: 2rem; flex-wrap: wrap; }
}

@media (max-width: 768px) {
  .bg-hero { padding-top: 3rem; margin-bottom: 3rem; }
  .bg-title { font-size: 2.5rem; }
  .bg-badge-card { padding: 2rem 1.5rem; }
}

/* -- UTILITIES -- */
.bg-primary { background: var(--primary) !important; }
.bg-success { background: var(--success) !important; }
.bg-danger { background: var(--danger) !important; }
.bg-warning { background: var(--warning) !important; }
.text-primary { color: var(--primary) !important; }
.text-success { color: var(--success) !important; }
.text-danger { color: var(--danger) !important; }
.text-warning { color: var(--warning) !important; }

/* -- ANIMATIONS -- */
@keyframes rdp-pulse-glow {
  0% { box-shadow: 0 0 5px rgba(139, 92, 246, 0.2); }
  50% { box-shadow: 0 0 20px rgba(139, 92, 246, 0.5); }
  100% { box-shadow: 0 0 5px rgba(139, 92, 246, 0.2); }
}

.rdp-pulse {
  animation: rdp-pulse-glow 2s infinite;
}

/* -- TERMINAL -- */
.rdp-terminal {
  margin: 2rem 0;
  background: #0D1117;
  border: 1px solid #30363D;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 20px 50px rgba(0,0,0,0.4);
}
.rdp-terminal-head {
  padding: 12px 16px;
  background: #161B22;
  border-bottom: 1px solid #30363D;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.rdp-copy-btn {
  color: #8B949E;
  background: none;
  border: none;
  cursor: pointer;
  transition: color 0.2s;
}
.rdp-copy-btn:hover { color: #fff; }
.rdp-terminal-body {
  padding: 1.5rem;
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.9rem;
  color: #E6EDF3;
  line-height: 1.6;
  overflow-x: auto;
}
.rdp-terminal-prompt {
  color: var(--primary);
  margin-right: 12px;
  user-select: none;
  font-weight: 800;
}

/* -- CUSTOM SCROLLBAR -- */
.custom-scrollbar::-webkit-scrollbar { width: 6px; }
.custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
.custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.05); border-radius: 99px; }
.custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.1); }

